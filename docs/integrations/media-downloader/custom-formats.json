[
    {
        "id": 1,
        "name": "CAM / Telesync / Screener (Unwanted)",
        "includeCustomFormatWhenRenaming": false,
        "specifications": [
            {
                "name": "CAM",
                "implementation": "ReleaseTitleSpecification",
                "implementationName": "Release Title",
                "infoLink": "https://wiki.servarr.com/radarr/settings#custom-formats-2",
                "negate": false,
                "required": false,
                "fields": [
                    {
                        "order": 0,
                        "name": "value",
                        "label": "Regular Expression",
                        "helpText": "Custom Format RegEx is Case Insensitive",
                        "value": "\\b(?:CAMRIP|(?:NEW)?CAM|HD-?CAM(?:Rip)?|HQCAM)\\b",
                        "type": "textbox",
                        "advanced": false,
                        "privacy": "normal",
                        "isFloat": false
                    }
                ]
            },
            {
                "name": "Telesync",
                "implementation": "ReleaseTitleSpecification",
                "implementationName": "Release Title",
                "infoLink": "https://wiki.servarr.com/radarr/settings#custom-formats-2",
                "negate": false,
                "required": false,
                "fields": [
                    {
                        "order": 0,
                        "name": "value",
                        "label": "Regular Expression",
                        "helpText": "Custom Format RegEx is Case Insensitive",
                        "value": "\\b(?:TS[-_. ]|TELESYNCH?|HD-?TS|PDVD|(?:HD)?TSRip)",
                        "type": "textbox",
                        "advanced": false,
                        "privacy": "normal",
                        "isFloat": false
                    }
                ]
            },
            {
                "name": "Telecine",
                "implementation": "ReleaseTitleSpecification",
                "implementationName": "Release Title",
                "infoLink": "https://wiki.servarr.com/radarr/settings#custom-formats-2",
                "negate": false,
                "required": false,
                "fields": [
                    {
                        "order": 0,
                        "name": "value",
                        "label": "Regular Expression",
                        "helpText": "Custom Format RegEx is Case Insensitive",
                        "value": "\\b(?:TELECINE|HD-?TC)\\b",
                        "type": "textbox",
                        "advanced": false,
                        "privacy": "normal",
                        "isFloat": false
                    }
                ]
            },
            {
                "name": "Screener",
                "implementation": "ReleaseTitleSpecification",
                "implementationName": "Release Title",
                "infoLink": "https://wiki.servarr.com/radarr/settings#custom-formats-2",
                "negate": false,
                "required": false,
                "fields": [
                    {
                        "order": 0,
                        "name": "value",
                        "label": "Regular Expression",
                        "helpText": "Custom Format RegEx is Case Insensitive",
                        "value": "\\b(?:SCR|(?:DVD)?SCREENER|DVDSCR)\\b",
                        "type": "textbox",
                        "advanced": false,
                        "privacy": "normal",
                        "isFloat": false
                    }
                ]
            },
            {
                "name": "Workprint",
                "implementation": "ReleaseTitleSpecification",
                "implementationName": "Release Title",
                "infoLink": "https://wiki.servarr.com/radarr/settings#custom-formats-2",
                "negate": false,
                "required": false,
                "fields": [
                    {
                        "order": 0,
                        "name": "value",
                        "label": "Regular Expression",
                        "helpText": "Custom Format RegEx is Case Insensitive",
                        "value": "\\b(?:WORKPRINT)\\b",
                        "type": "textbox",
                        "advanced": false,
                        "privacy": "normal",
                        "isFloat": false
                    }
                ]
            }
        ]
    },
