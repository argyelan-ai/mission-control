# Journey-test stack front door: same routing as the product Caddyfile
# (/api and /health → backend, rest → frontend), plain HTTP, no LiveKit.
:80 {
    handle /api/v1/internal/* {
        respond 403
    }
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
