# Environment
.env
.env.local
.env.production
.env.backup*
docker/.env.agents
docker/.env.shared

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
# No trailing slash, on purpose: `node_modules/` matches a DIRECTORY only.
# Working in git worktrees (the norm here) usually means symlinking the deps
# in from another worktree — and that symlink was NOT ignored: it landed in a
# commit carrying its absolute host path (caught by the leak gate, 2026-08-20).
# Without the slash both the directory and the symlink are covered.
node_modules
.next/
out/
.turbo/

# TypeScript incremental build cache (generated by tsc --incremental)
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code
.claude/

# Docker
docker-compose.override.yml
docker/.env.agents

# Logs
*.log

# Backups
backups/

# Build artifacts
dist/
build/
.cache/
.worktrees/
.superpowers/

# Stray local dev files (should never be committed)
backend/mission_control.db
*.sqlite
*.sqlite3
frontend-v2/src/styles/*.backup

# Renderer backups (compose_renderer.py writes *.bak on each overwrite —
# safety net to prevent data loss during runtime switches, not for tracking)
*.bak

# Tailscale HTTPS certs (private keys — NEVER commit)
caddy/certs/

# Host-specific Caddy config (TLS variant, see caddy/Caddyfile.tls.example)
caddy/Caddyfile.local

# ── Private dev overlay (scripts/dev-overlay.sh) ─────────────────────────
# Maintainer-private verticals & config live in a separate private repo and
# are synced into these paths locally. Never committed here.
backend/scripts/test_news_bridge.py
backend/app/verticals/*
!backend/app/verticals/__init__.py
!backend/app/verticals/hooks.py
# bench_studio is a PUBLIC vertical (ADR-069) — un-ignore it so new files
# aren't silently skipped (its first commit had to be force-added and
# dragged __pycache__ into the index).
!backend/app/verticals/bench_studio/
backend/app/verticals/bench_studio/__pycache__/
frontend-v2/src/verticals/
frontend-v2/src/app/content/
frontend-v2/src/app/news/
CLAUDE.local.md
.mcp.json
journal.md
docs/plans/
docs/runbooks/
docs/news-*.md
docs/omp-bridge-REPORT.md
# generated locally by tools/generate-*.py
docs/code-map.md
docs/agent-state.md

# Fontshare fonts are licensed for use but must not be redistributed
# verbatim — generated at Docker build time by fetch_fonts.py, never in git.
docker/mc-playwright/templates/bench/fonts/embedded-fonts.css

# Operator-specific SOUL addendum (private overlay) — never commit here.
backend/templates/SOUL.operator.md.j2

# Impeccable design-hook cache (config.json bleibt getrackt)
.impeccable/hook.cache.json

# Your own agent fleet. This file is rewritten at runtime
# (backend/app/services/compose_renderer.py) and describes its owner's machine:
# agent names, project/client references, mount paths. While it was in version
# control, every commit published its author's fleet. Shipped instead is the
# agent-free template docker/docker-compose.agents.example.yml; ./setup.sh
# makes your copy from it on first run.
# (It stays inside the repo folder rather than under ~/.mc/ as ADR-022 would
# have it — a documented exception, see that ADR.)
docker/docker-compose.agents.yml
# And its sidecars: the renderer writes .tmp/.bak, the update migration writes
# .pre-oss-split (scripts/migrate-agents-yml.sh). All carry the same fleet.
docker/docker-compose.agents.yml.*
