# Mission Control — Caddy reverse proxy.
#
# Serves plain HTTP on :80 — fine for localhost (secure context for WebRTC).
# For HTTPS (Tailscale / LAN certs), see caddy/Caddyfile.tls.example and
# docker-compose.override.example.yml — never commit certs or hostnames here.
#
# /livekit-signal is the WebSocket proxy to LiveKit signaling (RTC media
# ports 7881/7882 are exposed separately on 0.0.0.0).

(common) {
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # WebSocket-Proxy fuer LiveKit-Signaling (vom Browser zum LK-Server).
    # LiveKit's Web-SDK upgrades auf WS — Caddy handles upgrade transparent.
    handle /livekit-signal/* {
        uri strip_prefix /livekit-signal
        reverse_proxy livekit:7880
    }
    handle /livekit-signal {
        uri strip_prefix /livekit-signal
        reverse_proxy livekit:7880
    }
    handle /rtc {
        reverse_proxy livekit:7880
    }
    handle /rtc/* {
        reverse_proxy livekit:7880
    }

    # Internal-only endpoints (agent bootstrap: hands out Vault secrets in
    # plaintext) must never be reachable from outside the Docker network,
    # regardless of MC_BIND_ADDRESS. (PR #404 Rex review: this exception did
    # not exist before, despite internal.py's docstring claiming it did.)
    #
    # Order in this file does not decide the match: Caddy sorts `handle`
    # blocks by path specificity when it adapts the config, so
    # /api/v1/internal/* wins over /api/* wherever it stands — verified with
    # `caddy adapt` on the generated JSON routes. It is written first anyway
    # because that is how it reads to a human.
    handle /api/v1/internal/* {
        respond 403
    }

    # API + Health → backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }

    # Default: Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}

# Local HTTP access. No TLS needed — localhost is a secure context for
# browser WebRTC.
:80 {
    import common
}
