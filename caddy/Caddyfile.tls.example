# Caddyfile.tls.example — HTTPS variant of the shipped Caddyfile.
#
# Use this when you want to reach Mission Control from other devices with
# valid TLS (e.g. via Tailscale: `tailscale cert <your-host>.ts.net`).
#
# 1. cp caddy/Caddyfile.tls.example caddy/Caddyfile.local
# 2. Replace <your-hostname> and put the cert/key into caddy/certs/
#    (gitignored — never commit certificates).
# 3. Mount Caddyfile.local over the default — see
#    docker-compose.override.example.yml.

# Never log credentials from URLs. Browsers cannot send an Authorization
# header on EventSource/WebSocket, so stream URLs carry a short-lived,
# single-use `?ticket=` (older clients: the login JWT as `?token=`). Caddy
# writes the request URI into its log lines (e.g. reverse_proxy errors when a
# stream is cut off), so redact both parameters on the default logger — it
# covers the error log and any access log that is not configured separately.
# If you add a site `log` directive, give it the same `format filter`.
{
	log default {
		output stderr
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
				replace ticket REDACTED
				replace access_token REDACTED
			}
		}
	}
}

(common) {
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        # `?` = only when the backend set none: the HTML preview's folder view
        # and the bench viewer send no-referrer on purpose (agent-written pages
        # must not send MC's host name to the CDNs they load). This block is
        # deferred (it deletes Server), so a plain line would overwrite theirs.
        # Test: caddy/test_upstream_headers.sh
        ?Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # WebSocket proxy for LiveKit signaling (browser → LK server).
    handle /livekit-signal/* {
        uri strip_prefix /livekit-signal
        reverse_proxy livekit:7880
    }
    handle /livekit-signal {
        uri strip_prefix /livekit-signal
        reverse_proxy livekit:7880
    }
    handle /rtc {
        reverse_proxy livekit:7880
    }
    handle /rtc/* {
        reverse_proxy livekit:7880
    }

    # Internal-only endpoints (agent bootstrap: hands out Vault secrets in
    # plaintext) must never be reachable from outside the Docker network —
    # this file is exactly the multi-device/Tailscale/LAN exposure case
    # (PR #404 Rex review), so this block matters here more than anywhere.
    # Must come BEFORE the generic /api/* handle below.
    handle /api/v1/internal/* {
        respond 403
    }

    # API + health → backend. No active health checks: a dial failure to a
    # stopped/unreachable upstream is already a 502, which handle_errors
    # below catches (`in [502, 503]`). An active check was tried and
    # reverted (PR 7 of the mc-update plan) — one slow-but-live /health
    # call past the check's timeout made Caddy mark the whole backend
    # unhealthy and 503 every /api/* request, including POSTs, which is a
    # worse outage than the update window it was meant to soften.
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }

    # Default: Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    # Maintenance page — self-contained, reusable block for your own
    # Caddyfile. Copy this `handle_errors` block plus
    # caddy/maintenance/503.html into your setup (adjust the `root` path to
    # wherever you mount that file). While backend or frontend is down, a
    # request-time dial failure to it is a 502. Every such 502/503 gets
    # `Retry-After: 5`; a browser page load (Accept contains text/html) also
    # gets a self-reloading "MC is not responding" page (EN/DE the way MC
    # picks it: NEXT_LOCALE cookie, then Accept-Language; light/dark by the
    # browser's OS preference). Fetch, API and script callers keep the bare
    # 502 — no HTML in their error messages.
    handle_errors {
        @mc_restarting expression {err.status_code} in [502, 503]
        header @mc_restarting Retry-After "5"
        @mc_restarting_page {
            expression {err.status_code} in [502, 503]
            header Accept *text/html*
        }
        handle @mc_restarting_page {
            rewrite * /503.html
            templates
            root * /etc/caddy/maintenance
            file_server
        }
    }
}

# Local HTTP access (from the host itself).
:80 {
    import common
}

# HTTPS endpoint with your own certificate.
<your-hostname> {
    tls /etc/caddy/certs/<your-hostname>.crt /etc/caddy/certs/<your-hostname>.key
    import common
    header Strict-Transport-Security "max-age=31536000"
    header X-Frame-Options DENY
}
