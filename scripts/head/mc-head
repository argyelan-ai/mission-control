#!/usr/bin/env python3
"""mc-head — run ONE short-lived head (one process, one job) on this host.

Spec: docs/specs/head-launcher.md (§5, §6.1, §6.3, §6.5, §9).

The Mission Control backend never gets a shell on the host. It only writes a
run folder ($MC_HOME/heads/<run_id>/{spec.json, job.md, procedure.md,
head.env}) and drops a spool request ($MC_HOME/heads/spool/<run_id>.<action>.json).
A launchd job runs ``mc-head watch``; everything with harness knowledge lives
in THIS file (one table, ``harness_argv``).

Usable without MC from a terminal:

    mc-head validate <run_id>        check spec.json, print "ok" or the reason
    mc-head start <run_id>           prepare worktree + guards, start the head
    mc-head stop <run_id>            stop a running head (TERM, grace, KILL)
    mc-head restart <old> <new>      stop <old>, wait until it has exited and
                                     released its box lock, then start <new>
    mc-head status <run_id>          print .wrapper/status.json
    mc-head watch                    process the spool once (launchd entry)

Python 3.9 stdlib only, so the macOS system python can run it from launchd.
Nothing in here trusts spec.json: the backend container mounts $MC_HOME
read-write, so every value is checked against a fixed pattern before it
reaches git, tmux or the harness — and nothing is ever passed through a shell.
"""
from __future__ import annotations

import json
import os
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
import uuid
from datetime import datetime, timezone
