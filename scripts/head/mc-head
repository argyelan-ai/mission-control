# ── validation (§6.1) ────────────────────────────────────────────────────

UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
PATTERNS = {
    "repo_full_name": re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"),
    # "mc-head/", not "head/": on a case-insensitive disk (macOS) the
    # remote-tracking ref refs/remotes/origin/head/… collides with
    # refs/remotes/origin/HEAD and every later fetch fails (live 2026-09-23).
    "branch": re.compile(r"^mc-head/[a-z0-9-]+$"),
    "base_branch": re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,100}$"),
    "base_url": re.compile(r"^https?://[A-Za-z0-9.-]+:[0-9]+(/[A-Za-z0-9/._-]*)?$"),
    "model": re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/:-]{0,200}$"),
    "runtime_slug": re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$"),
    # vault jobs/<job_folder>/run-record.md — where the wrapper files the record
    "job_folder": re.compile(r"^[a-z0-9][a-z0-9-]{0,99}$"),
}
HARNESSES = ("omp", "claude")
MODES = ("fresh", "continue")

# Keys mc-head accepts from head.env (written by the backend). Anything else
# is dropped: the head's environment is built from nothing (env -i).
HEAD_ENV_KEYS = frozenset(
    {
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "ANTHROPIC_SMALL_FAST_MODEL",
        "ANTHROPIC_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL",
        "OPENAI_API_KEY",
    }
)


class SpecInvalid(Exception):
    def __init__(self, field: str, why: str) -> None:
        super().__init__(f"{field}: {why}")
        self.field = field


def _is_uuid(value) -> bool:
    return isinstance(value, str) and bool(UUID_RE.match(value))


def check_run_id(run_id: str) -> None:
    if not _is_uuid(run_id):
        raise SpecInvalid("run_id", "not a lowercase uuid")


def load_spec(run_id: str) -> dict:
    """Read + validate spec.json. Raises SpecInvalid on any mismatch."""
    check_run_id(run_id)
    path = run_dir(run_id) / "spec.json"
    try:
        spec = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise SpecInvalid("spec.json", f"unreadable ({exc.__class__.__name__})")
    if not isinstance(spec, dict):
        raise SpecInvalid("spec.json", "not an object")
    if spec.get("run_id") != run_id:
        raise SpecInvalid("run_id", "does not match the run folder")
    for field, pattern in PATTERNS.items():
        value = spec.get(field)
        if not isinstance(value, str) or not pattern.match(value) or ".." in value:
            raise SpecInvalid(field, "does not match the allowed pattern")
    if spec["branch"] in ("mc-head/main", "mc-head/master"):
        raise SpecInvalid("branch", "reserved name")
    if spec.get("harness") not in HARNESSES:
        raise SpecInvalid("harness", "not in the harness table")
    if spec.get("mode") not in MODES:
        raise SpecInvalid("mode", "must be fresh or continue")
    limit = spec.get("time_limit_s")
    if not isinstance(limit, int) or isinstance(limit, bool) or not 60 <= limit <= 86400:
        raise SpecInvalid("time_limit_s", "integer between 60 and 86400")
    boxes = spec.get("box_keys")
    if not isinstance(boxes, list) or not all(_is_uuid(b) for b in boxes):
        raise SpecInvalid("box_keys", "list of host uuids")
    rf = spec.get("restarted_from")
    if rf is not None and not _is_uuid(rf):
        raise SpecInvalid("restarted_from", "uuid or null")
    if spec["mode"] == "continue" and rf is None:
        raise SpecInvalid("restarted_from", "continue mode needs the previous run")
    task_id = spec.get("task_id")
    if task_id is not None and not _is_uuid(task_id):
        raise SpecInvalid("task_id", "uuid or null")
    return spec


def read_head_env(run_id: str) -> dict:
    """head.env → only the allow-listed keys, single-line values."""
    out: dict = {}
    path = run_dir(run_id) / "head.env"
    if not path.exists():
        return out
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        if key in HEAD_ENV_KEYS and "\n" not in value and "\x00" not in value:
            out[key] = value
    return out


# ── status (host → MC contract, §6.1) ────────────────────────────────────


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_status(run_id: str) -> dict:
    try:
        return json.loads((wrapper_dir(run_id) / "status.json").read_text())
    except (OSError, ValueError):
        return {}


def write_status(run_id: str, **fields) -> dict:
    wdir = wrapper_dir(run_id)
    wdir.mkdir(parents=True, exist_ok=True)
    status = {
        "run_id": run_id,
        "phase": "starting",
        "pid": None,
        "pgid": None,
        "supervisor_pid": None,
        "external_ref": None,
        "tmux": None,
        "started_at": None,
        "exited_at": None,
        "exit_code": None,
        "last_output_at": None,
        "pr_url": None,
        "scratch_branch_pushed": False,
        "run_record_path": None,
        "question": False,
        "reason": None,
    }
    status.update(read_status(run_id))
    status.update(fields)
    tmp = wdir / f".status.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(status, indent=1))
    os.replace(tmp, wdir / "status.json")
    return status


def exit_status(run_id: str, reason: str, **extra) -> None:
    write_status(run_id, phase="exited", exited_at=now_iso(), reason=reason, **extra)


def log(msg: str) -> None:
    sys.stderr.write(f"[mc-head {now_iso()}] {msg}\n")
    sys.stderr.flush()


# ── process helpers ──────────────────────────────────────────────────────


def pid_alive(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # A zombie child of ours still answers kill(0); reap check via ps state.
    try:
        out = subprocess.run(
            ["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True, timeout=5
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return True
    return bool(out) and not out.startswith("Z")


def pid_start(pid: int) -> str:
    try:
        return subprocess.run(
            ["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=5
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def kill_group(pgid, grace: float, proc=None) -> None:
    """SIGTERM to the process group, wait ``grace``, then SIGKILL."""
    if not isinstance(pgid, int) or pgid <= 1:
        return
    # EPERM from killpg on macOS = only zombies are left in the group
    # (exited, not yet reaped) — that counts as gone.
    try:
        os.killpg(pgid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        return
    deadline = time.time() + grace
    while time.time() < deadline:
        if proc is not None and proc.poll() is not None:
            break  # leader gone; still KILL whatever else is left in the group
        try:
            os.killpg(pgid, 0)
        except (ProcessLookupError, PermissionError):
            return
        time.sleep(0.2)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


# ── box lock with owner (§6.3 step 4) ────────────────────────────────────


def _lock_owner_alive(lock: Path) -> bool:
    try:
        owner = json.loads((lock / "owner.json").read_text())
    except (OSError, ValueError):
        # Folder exists but no owner yet: another wrapper is between mkdir
        # and writing the owner. Treat as alive for a short window.
        try:
            return time.time() - lock.stat().st_mtime < 10
        except OSError:
            return False
    pid = owner.get("pid")
    return pid_alive(pid) and pid_start(pid) == owner.get("start")


def acquire_locks(run_id: str, box_keys: list) -> tuple:
    """mkdir-based lock per box. Returns (ok, taken, busy_key)."""
    locks_root().mkdir(parents=True, exist_ok=True)
    owner = {"pid": os.getpid(), "start": pid_start(os.getpid()), "run_id": run_id, "since": now_iso()}
    taken: list = []
    for key in box_keys:
        lock = locks_root() / key
        for _attempt in range(2):
            try:
                lock.mkdir()
            except FileExistsError:
                if _lock_owner_alive(lock):
                    release_locks(run_id, taken)
                    return False, [], key
                log(f"stale lock on box {key} (owner gone) — taking it over")
                shutil.rmtree(lock, ignore_errors=True)
                continue
            (lock / "owner.json").write_text(json.dumps(owner))
            taken.append(key)
            break
        else:
            release_locks(run_id, taken)
            return False, [], key
    (wrapper_dir(run_id) / "lock-owner").write_text(json.dumps({**owner, "box_keys": taken}))
    return True, taken, None


def release_locks(run_id: str, keys: list) -> None:
    for key in keys:
        lock = locks_root() / key
        try:
            owner = json.loads((lock / "owner.json").read_text())
        except (OSError, ValueError):
            owner = {}
        if owner.get("run_id") in (run_id, None):
            shutil.rmtree(lock, ignore_errors=True)


def locks_held_by(run_id: str) -> list:
    held = []
    if not locks_root().is_dir():
        return held
    for lock in locks_root().iterdir():
        try:
            if json.loads((lock / "owner.json").read_text()).get("run_id") == run_id:
                held.append(lock.name)
        except (OSError, ValueError):
            continue
    return held


# ── git: clone, worktree, guards (§6.3 steps 1–3) ────────────────────────


def _git_overrides() -> list:
    """``-c`` flags on every wrapper git call. The wrapper runs git OUTSIDE
    the sandbox in a clone whose .git/ the head can write: no fsmonitor, the
    wrapper's own hooks dir only, never the ext:: transport. (The clone's
    config is also rewritten from scratch before each step, see
    sanitize_clone(); these flags hold even if that was raced.)"""
    return [
        "-c", "core.fsmonitor=false",
        "-c", f"core.hooksPath={hooks_dir()}",
        "-c", "protocol.ext.allow=never",
        "-c", "core.sshCommand=ssh",
    ]


def _git(args: list, cwd=None, env=None, check=True) -> subprocess.CompletedProcess:
    full_env = dict(os.environ)
    full_env["GIT_CONFIG_GLOBAL"] = "/dev/null"
    full_env["GIT_CONFIG_NOSYSTEM"] = "1"
    full_env["GIT_TERMINAL_PROMPT"] = "0"
    if env:
        full_env.update(env)
    res = subprocess.run(
        ["git", *_git_overrides(), *args], cwd=cwd or "/", env=full_env, capture_output=True, text=True,
        timeout=600,
    )
    if check and res.returncode != 0:
        raise RuntimeError(f"git {' '.join(args[:2])} failed: {res.stderr.strip()[-400:]}")
    return res


PRE_PUSH_HOOK = r"""#!/bin/sh
# mc-head guard (spec §9 layer 2): heads may only push their own mc-head/* branch,
# never delete, never rewrite history. Guard rail only — the server-side gate
# is the head's own non-admin GitHub identity.
zero=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/mc-head/*) ;;
    *) echo "mc-head: push to $remote_ref refused (heads push only mc-head/* branches)" >&2; exit 1 ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    echo "mc-head: deleting $remote_ref refused" >&2; exit 1
  fi
  if [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "mc-head: non-fast-forward push to $remote_ref refused" >&2; exit 1
    fi
  fi
done
exit 0
"""


def hooks_dir() -> Path:
    return clones_root() / ".mc-head-hooks"


def install_hooks(clone: Path) -> None:
    hdir = hooks_dir()
    hdir.mkdir(parents=True, exist_ok=True)
    hook = hdir / "pre-push"
    hook.write_text(PRE_PUSH_HOOK)
    hook.chmod(0o755)
    # core.hooksPath is written by sanitize_clone().


def gh_bin() -> str:
    return os.environ.get("MC_HEAD_GH") or shutil.which("gh") or "/opt/homebrew/bin/gh"


def gh_token() -> str | None:
    """The heads' own weak GitHub identity (§9 layer 4). Operator-provided
    file, never passed through the backend or the spool."""
    path = heads_root() / "gh-token"
    try:
        token = path.read_text().strip()
    except OSError:
        return None
    return token or None


def scratch_repos() -> set:
    path = heads_root() / "scratch-repos"
    try:
        return {ln.strip() for ln in path.read_text().splitlines() if ln.strip() and not ln.startswith("#")}
    except OSError:
        return set()


_URL_SAFE_RE = re.compile(r"^[^\s\x00-\x1f\x7f]+$")


def origin_url_allowed(full_name: str, url: str) -> bool:
    """Which ``remote.origin.url`` a clone may have (the head can rewrite it).

    Real repo: only GitHub for exactly this repo (https / git@ / ssh://git@).
    Scratch repo (listed): the same, or a local absolute path / ``file://``.
    Anything else (``ext::``, other hosts, other repos, relative paths) is
    refused before the wrapper runs a single git command against it.
    """
    if not url or not _URL_SAFE_RE.match(url) or "/../" in url or url.endswith("/.."):
        return False
    name = re.escape(full_name)
    github = re.compile(
        rf"^(https://github\.com/|git@github\.com:|ssh://git@github\.com/){name}(\.git)?/?$", re.I
    )
    if github.match(url):
        return True
    if full_name in scratch_repos():
        return url.startswith("/") or url.startswith("file:///")
    return False


def _config_file_get(cfg: Path, key: str) -> str:
    """Read one key from a config FILE: no repo discovery, no includes."""
    res = _git(["config", "--file", str(cfg), "--no-includes", "--get", key], check=False)
    return res.stdout.strip() if res.returncode == 0 else ""


def sanitize_clone(full_name: str, clone: Path) -> str:
    """Rewrite the clone's .git/config from scratch; return the origin URL.

    The head can write the clone's .git/ (its commits land there) and so
    could plant hooks, an fsmonitor, filter drivers, a credential helper,
    includes or a ``commondir`` redirect that the wrapper's unsandboxed git
    calls would execute. Before every wrapper step the config is rebuilt
    from a fixed set of keys, keeping only a validated origin URL.
    """
    gitdir = clone / ".git"
    if gitdir.is_symlink() or not gitdir.is_dir():
        raise RuntimeError("clone .git is not a plain directory")
    cfg = gitdir / "config"
    url = _config_file_get(cfg, "remote.origin.url") if cfg.is_file() and not cfg.is_symlink() else ""
    if not origin_url_allowed(full_name, url):
        raise RuntimeError("clone origin URL not allowed")
    # Files that redirect or extend the repo config — never legitimate here.
    for name in ("commondir", "config.worktree", "info/attributes"):
        p = gitdir / name
        if p.is_symlink() or p.is_file():
            p.unlink()
    tmp = gitdir / f".config.mc-head.{os.getpid()}"
    tmp.unlink(missing_ok=True)
    values = [
        ("core.repositoryformatversion", "0"),
        ("core.filemode", "true"),
        ("core.bare", "false"),
        ("core.logallrefupdates", "true"),
        ("core.hooksPath", str(hooks_dir())),
        ("remote.origin.url", url),
        ("remote.origin.fetch", "+refs/heads/*:refs/remotes/origin/*"),
        ("user.name", GIT_NAME),
        ("user.email", GIT_EMAIL),
    ]
    if (clone / ".GIT").exists():  # case-insensitive disk (macOS default)
        values.append(("core.ignorecase", "true"))
    if sys.platform == "darwin":
        values.append(("core.precomposeunicode", "true"))
    for key, value in values:
        _git(["config", "--file", str(tmp), key, value])
    # Only gh as credential helper (with the head's GH_TOKEN); the empty
    # first entry resets any other helper.
    _git(["config", "--file", str(tmp), "--add", "credential.helper", ""])
    _git(["config", "--file", str(tmp), "--add", "credential.helper", f"!{gh_bin()} auth git-credential"])
    os.replace(tmp, cfg)
    return url


def scratch_origin(spec: dict) -> Path | None:
    """The local bare origin of a scratch repo, or None.

    Only a repo listed in heads/scratch-repos whose clone's ``origin`` is a
    local path (plain or ``file://``) that resolves INSIDE
    ``heads/scratch-origin/`` counts. Such an origin has no GitHub PRs; the
    sandbox gets write access to exactly this path (push) and a pushed branch
    is the result (``scratch_branch_pushed``). Every real repo → None.
    """
    if spec.get("repo_full_name") not in scratch_repos():
        return None
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    url = _config_file_get(clone / ".git" / "config", "remote.origin.url")
    if url.startswith("file://"):
        from urllib.parse import unquote

        url = unquote(url[len("file://"):])
    if not url.startswith("/"):
        return None
    try:
        root = (heads_root() / "scratch-origin").resolve()
        path = Path(url).resolve()
    except (OSError, RuntimeError):
        return None
    if root not in path.parents or not path.is_dir():
        return None
    return path


CHECK_REFS = ("refs/mc-head-check/base", "refs/mc-head-check/branch")


def scratch_branch_pushed(spec: dict) -> bool:
    """The head branch exists on the local origin with commits beyond base.

    Never runs git INSIDE the origin (the head can write it): the wrapper
    re-sanitizes its own clone and fetches both refs from the origin — the
    serving side (upload-pack) is git's path that is safe to run against an
    untrusted repository — then counts in the clone.
    """
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    try:
        sanitize_clone(spec["repo_full_name"], clone)
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return False
    base_ref, branch_ref = CHECK_REFS
    try:
        fetched = _git(
            ["-C", str(clone), "fetch", "-q", "--no-tags", "--no-write-fetch-head", "origin",
             f"+refs/heads/{spec['base_branch']}:{base_ref}", f"+refs/heads/{spec['branch']}:{branch_ref}"],
            check=False,
        )
        if fetched.returncode != 0:
            return False
        res = _git(["-C", str(clone), "rev-list", "--count", f"{base_ref}..{branch_ref}"], check=False)
        return res.returncode == 0 and int(res.stdout.strip() or "0") > 0
    except (ValueError, OSError, subprocess.SubprocessError):
        return False
    finally:
        for ref in CHECK_REFS:
            _git(["-C", str(clone), "update-ref", "-d", ref], check=False)


def sandbox_exec() -> str:
    """sandbox-exec binary. Overridable ONLY for the test suite (a passthrough
    stand-in on Linux CI); the host watcher never sets it."""
    return os.environ.get("MC_HEAD_SANDBOX_EXEC") or "/usr/bin/sandbox-exec"


def sandbox_enabled() -> bool:
    return os.environ.get("MC_HEAD_SANDBOX") == "1" and Path(sandbox_exec()).exists()


def ensure_clone(full_name: str) -> Path:
    clone = clones_root() / full_name.replace("/", "--")
    if not (clone / ".git").exists():
        clones_root().mkdir(parents=True, exist_ok=True)
        token = gh_token()
        if not token:
            raise RuntimeError("no clone and no heads GitHub identity to create one")
        res = subprocess.run(
            [gh_bin(), "repo", "clone", full_name, str(clone), "--", "-q"],
            env={**os.environ, "GH_TOKEN": token, "GIT_CONFIG_GLOBAL": "/dev/null"},
            capture_output=True,
            text=True,
            timeout=900,
        )
        if res.returncode != 0:
            raise RuntimeError(f"gh repo clone failed: {res.stderr.strip()[-300:]}")
    # The head can write .git/ of this clone: rebuild its config from a fixed
    # key set before the wrapper runs anything in it (sanitize_clone). Only gh
    # as credential helper (with the head's GH_TOKEN); the operator's
    # keychain helper is never reached (GIT_CONFIG_GLOBAL=/dev/null).
    install_hooks(clone)
    sanitize_clone(full_name, clone)
    return clone


def prepare_worktree(spec: dict, clone: Path) -> Path:
    run = run_dir(spec["run_id"])
    wt = run / "wt"
    base = spec["base_branch"]
    branch = spec["branch"]
    token = gh_token()
    env = {"GH_TOKEN": token} if token else None
    _git(["-C", str(clone), "fetch", "-q", "origin"], env=env)
    if spec["mode"] == "continue":
        prev_wt = run_dir(spec["restarted_from"]) / "wt"
        if prev_wt.exists():
            # Keep uncommitted work: move the worktree, never recreate it.
            _git(["-C", str(clone), "worktree", "move", str(prev_wt), str(wt)])
        else:
            _git(["-C", str(clone), "worktree", "prune"])
            _git(["-C", str(clone), "worktree", "add", str(wt), branch])
    else:
        _git(["-C", str(clone), "worktree", "add", "-q", "-b", branch, str(wt), f"origin/{base}"])
    return wt


# ── guard shims (§9 layer 2) ─────────────────────────────────────────────

BLOCKED_TOOLS = ("docker", "ssh", "scp", "sftp", "sudo", "launchctl", "kubectl", "rsync")

BLOCK_SHIM = """#!/bin/sh
echo "mc-head: '{name}' is blocked for heads (see the Never list)." >&2
exit 126
"""

GH_SHIM = """#!/bin/sh
# mc-head gh guard: only pr create/view/list, repo view, auth status.
case "$1 $2" in
  "pr create"|"pr view"|"pr list"|"repo view"|"auth status"|"auth git-credential") exec {real} "$@" ;;
esac
echo "mc-head: 'gh $1 $2' is blocked for heads (never merge, never admin)." >&2
exit 126
"""


def write_shims(run: Path) -> Path:
    bdir = run / "bin"
    bdir.mkdir(parents=True, exist_ok=True)
    for name in BLOCKED_TOOLS:
        p = bdir / name
        p.write_text(BLOCK_SHIM.format(name=name))
        p.chmod(0o755)
    p = bdir / "gh"
    p.write_text(GH_SHIM.format(real=shlex.quote(gh_bin())))
    p.chmod(0o755)
    return bdir


