class SpecInvalid(Exception):
    def __init__(self, field: str, why: str) -> None:
        super().__init__(f"{field}: {why}")
        self.field = field


def _is_uuid(value) -> bool:
    return isinstance(value, str) and bool(UUID_RE.match(value))


def check_run_id(run_id: str) -> None:
    if not _is_uuid(run_id):
        raise SpecInvalid("run_id", "not a lowercase uuid")


def load_spec(run_id: str) -> dict:
    """Read + validate spec.json. Raises SpecInvalid on any mismatch."""
    check_run_id(run_id)
    path = run_dir(run_id) / "spec.json"
    try:
        spec = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise SpecInvalid("spec.json", f"unreadable ({exc.__class__.__name__})")
    if not isinstance(spec, dict):
        raise SpecInvalid("spec.json", "not an object")
    if spec.get("run_id") != run_id:
        raise SpecInvalid("run_id", "does not match the run folder")
    for field, pattern in PATTERNS.items():
        value = spec.get(field)
        if not isinstance(value, str) or not pattern.match(value) or ".." in value:
            raise SpecInvalid(field, "does not match the allowed pattern")
    if spec["branch"] in ("mc-head/main", "mc-head/master"):
        raise SpecInvalid("branch", "reserved name")
    if spec.get("harness") not in HARNESSES:
        raise SpecInvalid("harness", "not in the harness table")
    if spec.get("mode") not in MODES:
        raise SpecInvalid("mode", "must be fresh or continue")
    limit = spec.get("time_limit_s")
    if not isinstance(limit, int) or isinstance(limit, bool) or not 60 <= limit <= 86400:
        raise SpecInvalid("time_limit_s", "integer between 60 and 86400")
    quiet = spec.get("no_progress_s", DEFAULT_NO_PROGRESS_S)
    if not isinstance(quiet, int) or isinstance(quiet, bool) or not 60 <= quiet <= 86400:
        raise SpecInvalid("no_progress_s", "integer between 60 and 86400")
    spec["no_progress_s"] = quiet
    boxes = spec.get("box_keys")
    if not isinstance(boxes, list) or not all(_is_uuid(b) for b in boxes):
        raise SpecInvalid("box_keys", "list of host uuids")
    rf = spec.get("restarted_from")
    if rf is not None and not _is_uuid(rf):
        raise SpecInvalid("restarted_from", "uuid or null")
    if spec["mode"] == "continue" and rf is None:
        raise SpecInvalid("restarted_from", "continue mode needs the previous run")
    task_id = spec.get("task_id")
    if task_id is not None and not _is_uuid(task_id):
        raise SpecInvalid("task_id", "uuid or null")
    return spec


def read_head_env(run_id: str) -> dict:
    """head.env → only the allow-listed keys, single-line values."""
    out: dict = {}
    path = run_dir(run_id) / "head.env"
    if not path.exists():
        return out
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        if key in HEAD_ENV_KEYS and "\n" not in value and "\x00" not in value:
            out[key] = value
    return out


# ── status (host → MC contract, §6.1) ────────────────────────────────────


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_status(run_id: str) -> dict:
    try:
        return json.loads((wrapper_dir(run_id) / "status.json").read_text())
    except (OSError, ValueError):
        return {}


def write_status(run_id: str, **fields) -> dict:
    wdir = wrapper_dir(run_id)
    wdir.mkdir(parents=True, exist_ok=True)
    status = {
        "run_id": run_id,
        "phase": "starting",
        "pid": None,
        "pgid": None,
        "supervisor_pid": None,
        "external_ref": None,
        "tmux": None,
        "started_at": None,
        "exited_at": None,
        "exit_code": None,
        "last_output_at": None,
        "last_progress_at": None,
        "pr_url": None,
        "scratch_branch_pushed": False,
        "run_record_path": None,
        "question": False,
        "reason": None,
    }
    status.update(read_status(run_id))
    status.update(fields)
    tmp = wdir / f".status.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(status, indent=1))
    os.replace(tmp, wdir / "status.json")
    return status


def exit_status(run_id: str, reason: str, **extra) -> None:
    write_status(run_id, phase="exited", exited_at=now_iso(), reason=reason, **extra)


def log(msg: str) -> None:
    sys.stderr.write(f"[mc-head {now_iso()}] {msg}\n")
    sys.stderr.flush()


# ── process helpers ──────────────────────────────────────────────────────


def pid_alive(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # A zombie child of ours still answers kill(0); reap check via ps state.
    try:
        out = subprocess.run(
            ["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True, timeout=5
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return True
    return bool(out) and not out.startswith("Z")


def pid_start(pid: int) -> str:
    try:
        return subprocess.run(
            ["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=5
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def kill_group(pgid, grace: float, proc=None) -> None:
    """SIGTERM to the process group, wait ``grace``, then SIGKILL."""
    if not isinstance(pgid, int) or pgid <= 1:
        return
    # EPERM from killpg on macOS = only zombies are left in the group
    # (exited, not yet reaped) — that counts as gone.
    try:
        os.killpg(pgid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        return
    deadline = time.time() + grace
    while time.time() < deadline:
        if proc is not None and proc.poll() is not None:
            break  # leader gone; still KILL whatever else is left in the group
        try:
            os.killpg(pgid, 0)
        except (ProcessLookupError, PermissionError):
            return
        time.sleep(0.2)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


# ── box lock with owner (§6.3 step 4) ────────────────────────────────────


def _lock_owner_alive(lock: Path) -> bool:
    try:
        owner = json.loads((lock / "owner.json").read_text())
    except (OSError, ValueError):
        # Folder exists but no owner yet: another wrapper is between mkdir
        # and writing the owner. Treat as alive for a short window.
        try:
            return time.time() - lock.stat().st_mtime < 10
        except OSError:
            return False
    pid = owner.get("pid")
    return pid_alive(pid) and pid_start(pid) == owner.get("start")


def acquire_locks(run_id: str, box_keys: list) -> tuple:
    """mkdir-based lock per box. Returns (ok, taken, busy_key)."""
    locks_root().mkdir(parents=True, exist_ok=True)
    owner = {"pid": os.getpid(), "start": pid_start(os.getpid()), "run_id": run_id, "since": now_iso()}
    taken: list = []
    for key in box_keys:
        lock = locks_root() / key
        for _attempt in range(2):
            try:
                lock.mkdir()
            except FileExistsError:
                if _lock_owner_alive(lock):
                    release_locks(run_id, taken)
                    return False, [], key
                log(f"stale lock on box {key} (owner gone) — taking it over")
                shutil.rmtree(lock, ignore_errors=True)
                continue
            (lock / "owner.json").write_text(json.dumps(owner))
            taken.append(key)
            break
        else:
            release_locks(run_id, taken)
            return False, [], key
    (wrapper_dir(run_id) / "lock-owner").write_text(json.dumps({**owner, "box_keys": taken}))
    return True, taken, None


def release_locks(run_id: str, keys: list) -> None:
    for key in keys:
        lock = locks_root() / key
        try:
            owner = json.loads((lock / "owner.json").read_text())
        except (OSError, ValueError):
            owner = {}
        if owner.get("run_id") in (run_id, None):
            shutil.rmtree(lock, ignore_errors=True)


def locks_held_by(run_id: str) -> list:
    held = []
    if not locks_root().is_dir():
        return held
    for lock in locks_root().iterdir():
        try:
            if json.loads((lock / "owner.json").read_text()).get("run_id") == run_id:
                held.append(lock.name)
        except (OSError, ValueError):
            continue
    return held


# ── git: clone, worktree, guards (§6.3 steps 1–3) ────────────────────────


def _git_overrides() -> list:
    """``-c`` flags on every wrapper git call. The wrapper runs git OUTSIDE
    the sandbox in a clone whose .git/ the head can write: no fsmonitor, the
    wrapper's own hooks dir only, never the ext:: transport. (The clone's
    config is also rewritten from scratch before each step, see
    sanitize_clone(); these flags hold even if that was raced.)"""
    return [
        "-c", "core.fsmonitor=false",
        "-c", f"core.hooksPath={hooks_dir()}",
        "-c", "protocol.ext.allow=never",
        "-c", "core.sshCommand=ssh",
    ]


def _git(args: list, cwd=None, env=None, check=True) -> subprocess.CompletedProcess:
    full_env = dict(os.environ)
    full_env["GIT_CONFIG_GLOBAL"] = "/dev/null"
    full_env["GIT_CONFIG_NOSYSTEM"] = "1"
    full_env["GIT_TERMINAL_PROMPT"] = "0"
    if env:
        full_env.update(env)
    res = subprocess.run(
        ["git", *_git_overrides(), *args], cwd=cwd or "/", env=full_env, capture_output=True, text=True,
        timeout=600,
    )
    if check and res.returncode != 0:
        raise RuntimeError(f"git {' '.join(args[:2])} failed: {res.stderr.strip()[-400:]}")
    return res


PRE_PUSH_HOOK = r"""#!/bin/sh
# mc-head guard (spec §9 layer 2): heads may only push their own mc-head/* branch,
# never delete, never rewrite history. Guard rail only — the server-side gate
# is the head's own non-admin GitHub identity.
zero=0000000000000000000000000000000000000000
passed=""
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/mc-head/*) ;;
    *) echo "mc-head: push to $remote_ref refused (heads push only mc-head/* branches)" >&2; exit 1 ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    echo "mc-head: deleting $remote_ref refused" >&2; exit 1
  fi
  if [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "mc-head: non-fast-forward push to $remote_ref refused" >&2; exit 1
    fi
  fi
  passed="$passed $local_sha"
done
# Roter Faden: a repo with .kohaerenz.yaml must pass the push-time kz checks.
# Not drift/pr: they need the PR body, which does not exist yet (the head runs
# the full `kz check --pr-body-file` before `gh pr create`). New red findings
# (exit 1) block the push; a broken config (exit 2) or no kz only warns.
top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$top" ] && [ -f "$top/.kohaerenz.yaml" ]; then
  kz=__KZ_BIN__
  if [ -n "$kz" ] && [ -x "$kz" ]; then
    "$kz" -C "$top" check --only orphans,states,rules,anchors,adr,timebomb,links </dev/null >&2
    rc=$?
    if [ "$rc" = 1 ]; then
      echo "mc-head: push refused - kz check is red (see above). Fix it, or explain it in the PR under 'Known limits' and ask the operator." >&2
      exit 1
    fi
    [ "$rc" = 0 ] || echo "mc-head: warning - kz check ended with exit $rc; push without kz check" >&2
  else
    echo "mc-head: warning - kz not found on this host; push without kz check" >&2
  fi
fi
# Proof for the wrapper: these shas went through this hook. A pushed branch tip
# missing here was pushed around the hook (--no-verify) -> run "hook_bypassed".
if [ -n "$MC_HEAD_RUN_DIR" ]; then
  for sha in $passed; do echo "$sha"; done >> "$MC_HEAD_RUN_DIR/hook-passed.txt"
fi
exit 0
"""


def hooks_dir() -> Path:
    return clones_root() / ".mc-head-hooks"


def install_hooks(clone: Path) -> None:
    hdir = hooks_dir()
    hdir.mkdir(parents=True, exist_ok=True)
    hook = hdir / "pre-push"
    # The head's PATH has no kz: the hook gets the absolute path baked in.
    hook.write_text(PRE_PUSH_HOOK.replace("__KZ_BIN__", shlex.quote(kz_bin() or "")))
    hook.chmod(0o755)
    # core.hooksPath is written by sanitize_clone().


def gh_bin() -> str:
    return os.environ.get("MC_HEAD_GH") or shutil.which("gh") or "/opt/homebrew/bin/gh"


def gh_token() -> str | None:
    """The heads' own weak GitHub identity (§9 layer 4). Operator-provided
    file, never passed through the backend or the spool."""
    path = heads_root() / "gh-token"
    try:
        token = path.read_text().strip()
    except OSError:
        return None
    return token or None


def scratch_repos() -> set:
    path = heads_root() / "scratch-repos"
    try:
        return {ln.strip() for ln in path.read_text().splitlines() if ln.strip() and not ln.startswith("#")}
    except OSError:
        return set()


_URL_SAFE_RE = re.compile(r"^[^\s\x00-\x1f\x7f]+$")


def origin_url_allowed(full_name: str, url: str) -> bool:
    """Which ``remote.origin.url`` a clone may have (the head can rewrite it).

    Real repo: only GitHub for exactly this repo (https / git@ / ssh://git@).
    Scratch repo (listed): the same, or a local absolute path / ``file://``.
    Anything else (``ext::``, other hosts, other repos, relative paths) is
    refused before the wrapper runs a single git command against it.
    """
    if not url or not _URL_SAFE_RE.match(url) or "/../" in url or url.endswith("/.."):
        return False
    name = re.escape(full_name)
    github = re.compile(
        rf"^(https://github\.com/|git@github\.com:|ssh://git@github\.com/){name}(\.git)?/?$", re.I
    )
    if github.match(url):
        return True
    if full_name in scratch_repos():
        return url.startswith("/") or url.startswith("file:///")
    return False


def _config_file_get(cfg: Path, key: str) -> str:
    """Read one key from a config FILE: no repo discovery, no includes."""
    res = _git(["config", "--file", str(cfg), "--no-includes", "--get", key], check=False)
    return res.stdout.strip() if res.returncode == 0 else ""


def sanitize_clone(full_name: str, clone: Path) -> str:
    """Rewrite the clone's .git/config from scratch; return the origin URL.

    The head can write the clone's .git/ (its commits land there) and so
    could plant hooks, an fsmonitor, filter drivers, a credential helper,
    includes or a ``commondir`` redirect that the wrapper's unsandboxed git
    calls would execute. Before every wrapper step the config is rebuilt
    from a fixed set of keys, keeping only a validated origin URL.
    """
    gitdir = clone / ".git"
    if gitdir.is_symlink() or not gitdir.is_dir():
        raise RuntimeError("clone .git is not a plain directory")
    cfg = gitdir / "config"
    url = _config_file_get(cfg, "remote.origin.url") if cfg.is_file() and not cfg.is_symlink() else ""
    if not origin_url_allowed(full_name, url):
        raise RuntimeError("clone origin URL not allowed")
    # Files that redirect or extend the repo config — never legitimate here.
    for name in ("commondir", "config.worktree", "info/attributes"):
        p = gitdir / name
        if p.is_symlink() or p.is_file():
            p.unlink()
    tmp = gitdir / f".config.mc-head.{os.getpid()}"
    tmp.unlink(missing_ok=True)
    values = [
        ("core.repositoryformatversion", "0"),
        ("core.filemode", "true"),
        ("core.bare", "false"),
        ("core.logallrefupdates", "true"),
        ("core.hooksPath", str(hooks_dir())),
        ("remote.origin.url", url),
        ("remote.origin.fetch", "+refs/heads/*:refs/remotes/origin/*"),
        ("user.name", GIT_NAME),
        ("user.email", GIT_EMAIL),
    ]
    if (clone / ".GIT").exists():  # case-insensitive disk (macOS default)
        values.append(("core.ignorecase", "true"))
    if sys.platform == "darwin":
        values.append(("core.precomposeunicode", "true"))
    for key, value in values:
        _git(["config", "--file", str(tmp), key, value])
    # Only gh as credential helper (with the head's GH_TOKEN); the empty
    # first entry resets any other helper.
    _git(["config", "--file", str(tmp), "--add", "credential.helper", ""])
    _git(["config", "--file", str(tmp), "--add", "credential.helper", f"!{gh_bin()} auth git-credential"])
    os.replace(tmp, cfg)
    return url


def scratch_origin(spec: dict) -> Path | None:
    """The local bare origin of a scratch repo, or None.

    Only a repo listed in heads/scratch-repos whose clone's ``origin`` is a
    local path (plain or ``file://``) that resolves INSIDE
    ``heads/scratch-origin/`` counts. Such an origin has no GitHub PRs; the
    sandbox gets write access to exactly this path (push) and a pushed branch
    is the result (``scratch_branch_pushed``). Every real repo → None.
    """
    if spec.get("repo_full_name") not in scratch_repos():
        return None
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    url = _config_file_get(clone / ".git" / "config", "remote.origin.url")
    if url.startswith("file://"):
        from urllib.parse import unquote

        url = unquote(url[len("file://"):])
    if not url.startswith("/"):
        return None
    try:
        root = (heads_root() / "scratch-origin").resolve()
        path = Path(url).resolve()
    except (OSError, RuntimeError):
        return None
    if root not in path.parents or not path.is_dir():
        return None
    return path


CHECK_REFS = ("refs/mc-head-check/base", "refs/mc-head-check/branch")


def scratch_branch_pushed(spec: dict) -> bool:
    """The head branch exists on the local origin with commits beyond base.

    Never runs git INSIDE the origin (the head can write it): the wrapper
    re-sanitizes its own clone and fetches both refs from the origin — the
    serving side (upload-pack) is git's path that is safe to run against an
    untrusted repository — then counts in the clone.
    """
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    try:
        sanitize_clone(spec["repo_full_name"], clone)
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return False
    base_ref, branch_ref = CHECK_REFS
    try:
        fetched = _git(
            ["-C", str(clone), "fetch", "-q", "--no-tags", "--no-write-fetch-head", "origin",
             f"+refs/heads/{spec['base_branch']}:{base_ref}", f"+refs/heads/{spec['branch']}:{branch_ref}"],
            check=False,
        )
        if fetched.returncode != 0:
            return False
        res = _git(["-C", str(clone), "rev-list", "--count", f"{base_ref}..{branch_ref}"], check=False)
        return res.returncode == 0 and int(res.stdout.strip() or "0") > 0
    except (ValueError, OSError, subprocess.SubprocessError):
        return False
    finally:
        for ref in CHECK_REFS:
            _git(["-C", str(clone), "update-ref", "-d", ref], check=False)


def pushed_branch_tip(spec: dict) -> str | None:
    """sha of the head branch on origin, or None (not pushed / unreachable).
    Same safety as scratch_branch_pushed: fetch into the sanitized clone."""
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    ref = CHECK_REFS[1]
    token = gh_token()
    try:
        sanitize_clone(spec["repo_full_name"], clone)
        fetched = _git(["-C", str(clone), "fetch", "-q", "--no-tags", "--no-write-fetch-head", "origin",
                        f"+refs/heads/{spec['branch']}:{ref}"], env={"GH_TOKEN": token} if token else None, check=False)
        if fetched.returncode != 0:
            return None
        res = _git(["-C", str(clone), "rev-parse", "--verify", "--quiet", ref], check=False)
        tip = res.stdout.strip() if res.returncode == 0 else ""
        return tip or None
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return None
    finally:
        _git(["-C", str(clone), "update-ref", "-d", ref], check=False)


def hook_bypassed(spec: dict, tip_at_start: str | None) -> bool:
    """A branch tip pushed during this run that the pre-push hook never
    passed. Catches `git push --no-verify` / `-c core.hooksPath=`; a head
    that forges hook-passed.txt is lying on purpose — CI stays the gate."""
    tip = pushed_branch_tip(spec)
    if not tip or tip == tip_at_start:
        return False
    try:
        passed = read_head_file(run_dir(spec["run_id"]) / "hook-passed.txt")[0].split()
    except OSError:
        passed = []
    return tip not in passed


def sandbox_exec() -> str:
    """sandbox-exec binary. Overridable ONLY for the test suite (a passthrough
    stand-in on Linux CI); the host watcher never sets it."""
    return os.environ.get("MC_HEAD_SANDBOX_EXEC") or "/usr/bin/sandbox-exec"


def sandbox_enabled() -> bool:
    return os.environ.get("MC_HEAD_SANDBOX") == "1" and Path(sandbox_exec()).exists()


def ensure_clone(full_name: str) -> Path:
    clone = clones_root() / full_name.replace("/", "--")
    if not (clone / ".git").exists():
        clones_root().mkdir(parents=True, exist_ok=True)
        token = gh_token()
        if not token:
            raise RuntimeError("no clone and no heads GitHub identity to create one")
        res = subprocess.run(
            [gh_bin(), "repo", "clone", full_name, str(clone), "--", "-q"],
            env={**os.environ, "GH_TOKEN": token, "GIT_CONFIG_GLOBAL": "/dev/null"},
            capture_output=True,
            text=True,
            timeout=900,
        )
        if res.returncode != 0:
            raise RuntimeError(f"gh repo clone failed: {res.stderr.strip()[-300:]}")
    # The head can write .git/ of this clone: rebuild its config from a fixed
    # key set before the wrapper runs anything in it (sanitize_clone). Only gh
    # as credential helper (with the head's GH_TOKEN); the operator's
    # keychain helper is never reached (GIT_CONFIG_GLOBAL=/dev/null).
    install_hooks(clone)
    sanitize_clone(full_name, clone)
    return clone


def prepare_worktree(spec: dict, clone: Path) -> Path:
    run = run_dir(spec["run_id"])
    wt = run / "wt"
    base = spec["base_branch"]
    branch = spec["branch"]
    token = gh_token()
    env = {"GH_TOKEN": token} if token else None
    _git(["-C", str(clone), "fetch", "-q", "origin"], env=env)
    if spec["mode"] == "continue":
        prev_wt = run_dir(spec["restarted_from"]) / "wt"
        if prev_wt.exists():
            # Keep uncommitted work: move the worktree, never recreate it.
            _git(["-C", str(clone), "worktree", "move", str(prev_wt), str(wt)])
        else:
            _git(["-C", str(clone), "worktree", "prune"])
            _git(["-C", str(clone), "worktree", "add", str(wt), branch])
    else:
        _git(["-C", str(clone), "worktree", "add", "-q", "-b", branch, str(wt), f"origin/{base}"])
    return wt


# ── guard shims (§9 layer 2) ─────────────────────────────────────────────

BLOCKED_TOOLS = ("docker", "ssh", "scp", "sftp", "sudo", "launchctl", "kubectl", "rsync")

BLOCK_SHIM = """#!/bin/sh
echo "mc-head: '{name}' is blocked for heads (see the Never list)." >&2
exit 126
"""

GH_SHIM = """#!/bin/sh
# mc-head gh guard: only pr create/view/list, repo view, auth status.
case "$1 $2" in
  "pr create"|"pr view"|"pr list"|"repo view"|"auth status"|"auth git-credential") exec {real} "$@" ;;
esac
echo "mc-head: 'gh $1 $2' is blocked for heads (never merge, never admin)." >&2
exit 126
"""


KZ_SHIM = """#!/bin/sh
# mc-head: the coherence tool kz for the head (its PATH has no ~/.local/bin).
exec {real} "$@"
"""

KZ_MISSING_SHIM = """#!/bin/sh
echo "mc-head: kz check unavailable: kz is not installed on this host." >&2
exit 127
"""


def write_shims(run: Path) -> Path:
    bdir = run / "bin"
    bdir.mkdir(parents=True, exist_ok=True)
    for name in BLOCKED_TOOLS:
        p = bdir / name
        p.write_text(BLOCK_SHIM.format(name=name))
        p.chmod(0o755)
    p = bdir / "gh"
    p.write_text(GH_SHIM.format(real=shlex.quote(gh_bin())))
    p.chmod(0o755)
    kz = kz_bin()
    p = bdir / "kz"
    p.write_text(KZ_SHIM.format(real=shlex.quote(kz)) if kz else KZ_MISSING_SHIM)
    p.chmod(0o755)
    return bdir


# ── harness table (§6.3 step 3) — the ONLY place with harness commands ───


def harness_bin(name: str) -> str:
    override = os.environ.get(f"MC_HEAD_BIN_{name.upper()}")
    if override:
        return override
    found = shutil.which(name, path=BASE_PATH + ":" + str(Path.home() / ".local" / "bin"))
    return found or name


OMP_PROFILE = "mc-head"


def render_omp_profile(home: Path, spec: dict, env: dict) -> Path:
    """Same shape as backend host_provisioning.render_omp_host_models_yml.

    Rendered into the head's OWN $HOME, never the operator's omp config.
    """
    models_dir = home / ".omp" / "profiles" / OMP_PROFILE / "agent"
    models_dir.mkdir(parents=True, exist_ok=True)
    api_key = env.get("OPENAI_API_KEY")
    auth_line = f"    apiKey: {api_key}" if api_key else "    auth: none"
    text = (
        "providers:\n"
        "  mc-openai:\n"
        "    name: MC OpenAI-compatible endpoint\n"
        f"    baseUrl: {spec['base_url']}\n"
        "    api: openai-completions\n"
        f"{auth_line}\n"
        "    models:\n"
        f"      - id: {spec['model']}\n"
        "        name: MC model\n"
        "        reasoning: true\n"
        "        contextWindow: 262144\n"
        "        maxTokens: 32768\n"
    )
    path = models_dir / "models.yml"
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    return path


def _claude_abs(path: Path) -> str:
    """Claude Code permission syntax for an absolute path: ``//abs/path``."""
    return "/" + str(path)


# Claude Code warns `unrecognized_model` for a model its catalog does not know
# (every local engine model) and falls back to generic defaults. A modelPicker
# row with behavesAs (honoured from --settings) names a known model whose
# client-side handling applies; the model id sent to the engine is unchanged.
CLAUDE_BEHAVES_AS = os.environ.get("MC_HEAD_CLAUDE_BEHAVES_AS", "claude-sonnet-4-6")
CLAUDE_SMALL_BEHAVES_AS = os.environ.get("MC_HEAD_CLAUDE_SMALL_BEHAVES_AS", "claude-haiku-4-5")
CLAUDE_ALIASES = frozenset({"opus", "sonnet", "haiku", "best", "default", "opusplan"})


def claude_knows(model: str) -> bool:
    m = model.strip().lower()
    return m.startswith("claude") or re.sub(r"\[.*\]$", "", m) in CLAUDE_ALIASES


def claude_model_picker(env: dict) -> dict | None:
    """behavesAs rows for the head's models Claude Code does not know."""
    rows = []
    for key, behaves in (("ANTHROPIC_MODEL", CLAUDE_BEHAVES_AS), ("ANTHROPIC_SMALL_FAST_MODEL", CLAUDE_SMALL_BEHAVES_AS)):
        model = (env.get(key) or "").strip()
        if model and not claude_knows(model) and model not in [r["model"] for r in rows]:
            rows.append({"model": model, "behavesAs": behaves})
    return {"options": rows} if rows else None


def render_claude_settings(run: Path, env: dict | None = None) -> Path:
    """Render the head's Claude permission list.

    The template's ``~/`` rules alone are not enough: the head runs with
    HOME=<run>/home, so ``~`` points at the throw-away folder, not at the
    operator's home. Every ``~/`` deny rule is therefore repeated with the
    REAL home as an absolute rule. Edit is limited to the worktree and the
    head's own status files in the run folder — never the shell profile or
    another run. (Only Edit(path) rules: Claude Code ignores Write(path) in
    file permission checks — Edit rules cover every file-editing tool.)
    """
    data = json.loads(CLAUDE_SETTINGS_TEMPLATE.read_text())
    perms = data["permissions"]
    real_home = Path.home()
    deny = list(perms["deny"])
    for rule in perms["deny"]:
        m = re.match(r"^(\w+)\(~/(.*)\)$", rule)
        if m:
            deny.append(f"{m.group(1)}({_claude_abs(real_home / m.group(2))})")
    for rel in (".docker/**", ".netrc", ".git-credentials", ".kube/**", ".gnupg/**", ".aws/**",
                "Library/Keychains/**", "Library/Application Support/**", "Library/Cookies/**"):
        deny.append(f"Read({_claude_abs(real_home / rel)})")
    allow = [r for r in perms["allow"] if r not in ("Edit", "Write")]
    wt = run / "wt"
    allow.append(f"Edit({_claude_abs(wt)}/**)")
    for name in ("step.txt", "question.md", "run-record.md"):
        allow.append(f"Edit({_claude_abs(run / name)})")
    perms["allow"] = allow
    perms["deny"] = deny
    picker = claude_model_picker(env or {})
    if picker:
        data["modelPicker"] = picker
    target = run / "head-settings.json"
    target.write_text(json.dumps(data, indent=2))
    return target


def harness_argv(spec: dict, run: Path, home: Path, env: dict) -> list:
    job = (run / "job.md").read_text()
    procedure = str(run / "procedure.md")
    if spec["harness"] == "omp":
        render_omp_profile(home, spec, env)
        return [
            harness_bin("omp"),
            "--profile", OMP_PROFILE,
            "--model", f"mc-openai/{spec['model']}",
            "-p",
            # Keep the session in the run folder (not --no-session): it is
            # the only place omp records token usage, and the backend's
            # token harvester reads <run>/omp-sessions/*.jsonl.
            "--session-dir", str(run / "omp-sessions"),
            "--no-skills",
            # A little above the wrapper's effective hard limit (operator cap
            # included), so the wrapper stops first with reason "hard_limit".
            "--max-time", str(min(spec["time_limit_s"], MAX_TIME_S) + 30),
            # Permission bypass: allowed only inside the sandbox (ADR-086,
            # enforced in start_gate() for every run).
            "--auto-approve",
            "--append-system-prompt", procedure,
            job,
        ]
    if spec["harness"] == "claude":
        settings = render_claude_settings(run, env)
        argv = [
            harness_bin("claude"),
            "-p",
            "--bare",
            "--settings", str(settings),
            "--append-system-prompt-file", procedure,
        ]
        wt = run / "wt"
        for name in ("AGENTS.md", "CLAUDE.md"):
            if (wt / name).exists():
                argv += ["--add-dir", str(wt)]
                break
        # No prompt argument: --add-dir is variadic and would swallow it
        # (live finding). The job goes in on stdin — see harness_stdin().
        return argv
    raise SpecInvalid("harness", "not in the harness table")


def harness_stdin(spec: dict, run: Path):
    """Claude Code reads the job from stdin; omp gets it as the prompt argument."""
    if spec["harness"] == "claude":
        return open(run / "job.md", "rb")
    return subprocess.DEVNULL


def harness_env(spec: dict, run: Path, home: Path) -> dict:
    """env -i: only HOME, PATH (shims first), LANG, TERM + head.env + GH_TOKEN."""
    head_env = read_head_env(spec["run_id"])
    bindir = run / "bin"
    extra_dirs = []
    for name in ("omp", "claude"):
        b = harness_bin(name)
        if os.path.isabs(b):
            extra_dirs.append(str(Path(b).parent))
    path = ":".join([str(bindir), *extra_dirs, BASE_PATH])
    env = {
        "HOME": str(home),
        "PATH": path,
        "LANG": os.environ.get("LANG", "en_US.UTF-8"),
        "TERM": os.environ.get("TERM", "xterm-256color"),
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_AUTHOR_NAME": GIT_NAME,
        "GIT_AUTHOR_EMAIL": GIT_EMAIL,
        "GIT_COMMITTER_NAME": GIT_NAME,
        "GIT_COMMITTER_EMAIL": GIT_EMAIL,
        "MC_HEAD_RUN_DIR": str(run),
        "MC_HEAD_RUN_ID": spec["run_id"],
    }
    env.update(head_env)
    token = gh_token()
    if token:
        env["GH_TOKEN"] = token
    if spec["harness"] == "claude":
        env["CLAUDE_CONFIG_DIR"] = str(run / "claude-config")
        (run / "claude-config").mkdir(exist_ok=True)
    if spec["harness"] == "omp":
        (run / "omp-sessions").mkdir(exist_ok=True)
    return env


def sandbox_prefix(spec: dict, run: Path) -> list:
    if not sandbox_enabled():
        return []
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    params = {
        "RUN": str(run),
        "WT": str(run / "wt"),
        "CLONE_GIT": str(clone / ".git"),
        "VAULT_JOBS": str(vault_jobs()),
        "REAL_HOME": str(Path.home()),
        "MC_HOME": str(mc_home()),
        "USER_TMP": "/private/var/folders",
        # "" for every real repo: the profile grants nothing then.
        "SCRATCH_ORIGIN": str(scratch_origin(spec) or ""),
    }
    argv = [sandbox_exec(), "-f", str(SANDBOX_PROFILE)]
    for k, v in params.items():
        argv += ["-D", f"{k}={v}"]
    return argv


# ── kz brief (Roter Faden) ──────────────────────────────────────────────

KZ_TIMEOUT_S = float(os.environ.get("MC_HEAD_KZ_TIMEOUT_S", "20"))
KZ_BRIEF_MAX_LINES = 60
KZ_TEXT_MAX = 8000
KZ_MARK = "<!-- mc-head: kz brief -->"
KZ_HEADING = "## Context brief (kz)"
# Backticked, repo-relative paths in the job text: the brief's scope paths.
JOB_PATH_RE = re.compile(r"`([A-Za-z0-9_.][A-Za-z0-9_./-]{0,200})`")


def kz_bin() -> str | None:
    """The coherence tool kz: MC_HEAD_KZ_BIN (only that, when set), else
    ~/.local/bin/kz, else PATH. None when nothing executable is found."""
    override = os.environ.get("MC_HEAD_KZ_BIN")
    candidates = [override] if override else [str(Path.home() / ".local" / "bin" / "kz"), shutil.which("kz")]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def kz_scope_paths(job: str, wt: Path) -> list:
    """Backticked paths from the job that exist in the worktree (max. 20)."""
    out = []
    for tok in JOB_PATH_RE.findall(job):
        tok = tok.rstrip("/")
        if tok and ".." not in tok.split("/") and tok not in out and (wt / tok).exists():
            out.append(tok)
    return out[:20]


def run_kz_brief(spec: dict, run: Path, wt: Path) -> tuple:
    """(lines, None) or (None, reason). Runs like the head: sandboxed, env -i,
    with the wrapper's git hardening (the worktree may hold head-written files
    in continue mode)."""
    kz = kz_bin()
    if not kz:
        return None, "kz not found (set MC_HEAD_KZ_BIN or install kz to ~/.local/bin/kz)"
    job = read_head_file(run / "job.md")[0].split(KZ_MARK, 1)[0][:KZ_TEXT_MAX]
    overrides = _git_overrides()[1::2]
    env = {
        "HOME": str(run / "home"),
        "PATH": BASE_PATH,
        "LANG": os.environ.get("LANG", "en_US.UTF-8"),
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_COUNT": str(len(overrides)),
    }
    for i, kv in enumerate(overrides):
        key, value = kv.split("=", 1)
        env[f"GIT_CONFIG_KEY_{i}"], env[f"GIT_CONFIG_VALUE_{i}"] = key, value
    argv = [*sandbox_prefix(spec, run), kz, "-C", str(wt), "brief", "--paths", *kz_scope_paths(job, wt),
            f"--text={job}"]
    try:
        proc = subprocess.Popen(argv, cwd=str(wt), env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, start_new_session=True)
    except OSError as exc:
        return None, f"could not run ({exc.__class__.__name__})"
    try:
        out, err = proc.communicate(timeout=KZ_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        # kz and whatever it started (git grep …): the whole group goes.
        kill_group(proc.pid, 0, proc)
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        return None, f"timed out after {KZ_TIMEOUT_S:g} s"
    if proc.returncode != 0:
        last = (err.strip().splitlines() or [""])[-1][:200]
        return None, f"exit {proc.returncode}" + (f": {last}" if last else "")
    lines = out.rstrip().splitlines()
    return (lines[:KZ_BRIEF_MAX_LINES] or ["(empty)"]), None


def write_kz_brief(run: Path, lines, reason) -> None:
    """Append the brief section to job.md; a retry replaces it. Never read
    through a symlink; written next to it and renamed over it."""
    job = run / "job.md"
    text = read_head_file(job)[0].split("\n" + KZ_MARK, 1)[0].rstrip("\n") + "\n"
    section = [KZ_MARK, KZ_HEADING, ""]
    if lines is not None:
        section += ["Written by `kz brief` in this worktree before you started (max. 60 lines).",
                    "Step 0 builds on it.", "", "```text", *lines, "```"]
    else:
        section += [f"kz brief unavailable: {reason}"]
    tmp = run / ".job.md.kz.tmp"
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w") as fh:
        fh.write(text + "\n" + "\n".join(section) + "\n")
    os.replace(tmp, job)


def add_kz_brief(spec: dict, run: Path) -> None:
    """Never fails the start: any problem ends up as one line in job.md and
    in status.json (kz_brief)."""
    try:
        lines, reason = run_kz_brief(spec, run, run / "wt")
    except Exception as exc:  # noqa: BLE001 — kz must never stop a head
        lines, reason = None, f"error ({exc.__class__.__name__})"
    try:
        write_kz_brief(run, lines, reason)
    except OSError as exc:
        reason = reason or f"job.md not written ({exc.__class__.__name__})"
        lines = None
    write_status(spec["run_id"], kz_brief="ok" if lines is not None else f"unavailable: {reason}")
    if lines is None:
        log(f"kz brief unavailable: {reason}")


# ── start (§6.3) ─────────────────────────────────────────────────────────


# Branch rules that stop a direct push to the base branch (GitHub rules API).
PROTECTING_RULES = frozenset({"pull_request", "required_status_checks", "merge_queue", "update"})
IDENTITY_TTL_S = 24 * 3600


def _gh_api(path: str, token: str):
    res = subprocess.run(
        [gh_bin(), "api", path],
        env={**os.environ, "GH_TOKEN": token, "GIT_CONFIG_GLOBAL": "/dev/null"},
        capture_output=True, text=True, timeout=60,
    )
    if res.returncode != 0:
        raise RuntimeError(res.stderr.strip()[-200:])
    return json.loads(res.stdout or "null")


def identity_gate(spec: dict, token: str) -> str | None:
    """The heads' GitHub identity must be weak, and the base branch protected.

    GH_TOKEN sits in the head's environment, so the head can call the REST
    API directly (shims and deny rules are bypassable). What really holds
    against push-to-main / merge is (a) the token's identity has no admin or
    maintain right on the repo and (b) a GitHub rule on the base branch
    blocks direct pushes. Checked once, cached for a day and re-checked
    whenever the token file changes.
    """
    repo, base = spec["repo_full_name"], spec["base_branch"]
    cache = heads_root() / "identity-ok" / f"{repo.replace('/', '--')}--{base.replace('/', '--')}"
    try:
        token_mtime = (heads_root() / "gh-token").stat().st_mtime
        age = time.time() - cache.stat().st_mtime
        if age < IDENTITY_TTL_S and cache.stat().st_mtime >= token_mtime:
            return None
    except OSError:
        pass
    try:
        info = _gh_api(f"repos/{repo}", token)
        perms = (info or {}).get("permissions") or {}
        if not isinstance(perms, dict) or perms.get("admin") or perms.get("maintain"):
            return "gh_identity_unsafe"
        rules = _gh_api(f"repos/{repo}/rules/branches/{base}", token)
        types = {r.get("type") for r in rules if isinstance(r, dict)} if isinstance(rules, list) else set()
        if not types & PROTECTING_RULES:
            return "gh_identity_unsafe"
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError, AttributeError):
        return "gh_identity_unsafe"
    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(now_iso())
    return None


def start_gate(spec: dict) -> str | None:
    """Hard gates before a head may touch a repo (spec §9 rules).

    EVERY run, scratch repos included, needs the proven sandbox — for every
    harness: Claude's allow list still runs code the head wrote itself
    (pytest, npm test …), and without the sandbox a head could also write
    heads/scratch-repos (list a real repo as scratch) or .wrapper/status.json
    (fake a result). A real repo (not listed in heads/scratch-repos) also needs:
    - the heads' own GitHub identity (heads/gh-token);
    - a weak identity + protected base branch (identity_gate).
    Scratch repos (local test repos the operator listed) skip only those two.
    """
    if not sandbox_enabled():
        return "sandbox_required"
    if spec["repo_full_name"] in scratch_repos():
        return None
    token = gh_token()
    if not token:
        return "gh_identity_missing"
    return identity_gate(spec, token)


def cmd_validate(run_id: str) -> int:
    try:
        load_spec(run_id)
    except SpecInvalid as exc:
        print(f"spec_invalid {exc}")
        return 2
    print("ok")
    return 0


def cmd_start(run_id: str) -> int:
    try:
        check_run_id(run_id)
    except SpecInvalid as exc:
        print(f"spec_invalid {exc}")
        return 2
    if not run_dir(run_id).is_dir():
        print("spec_invalid run folder missing")
        return 2
    try:
        spec = load_spec(run_id)
    except SpecInvalid as exc:
        exit_status(run_id, "spec_invalid", detail=str(exc))
        print(f"spec_invalid {exc}")
        return 2
    current = read_status(run_id)
    if current.get("phase") in ("starting", "running") and pid_alive(current.get("supervisor_pid")):
        print("already running")
        return 0
    write_status(run_id, phase="starting", started_at=now_iso(), reason=None)
    gate = start_gate(spec)
    if gate:
        exit_status(run_id, gate)
        print(gate)
        return 3
    run = run_dir(run_id)
    try:
        clone = ensure_clone(spec["repo_full_name"])
        prepare_worktree(spec, clone)
        # continue mode: a tip pushed by the previous run is not this run's push
        write_status(run_id, branch_tip_at_start=pushed_branch_tip(spec) if spec["mode"] == "continue" else None)
        write_shims(run)
        (run / "home").mkdir(exist_ok=True)
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        exit_status(run_id, "prepare_failed", detail=str(exc)[-500:])
        print(f"prepare_failed {exc}")
        return 4
    add_kz_brief(spec, run)
    return launch_supervisor(run_id)


def launch_supervisor(run_id: str) -> int:
    me = [sys.executable, str(Path(__file__).resolve()), "_supervise", run_id]
    session = f"head-{run_id[:8]}"
    # tmux is opt-in (MC_HEAD_TMUX=1). Live finding 2026-09-23: inside a
    # tmux session omp (a Bun binary) could not reach the local engine's LAN
    # address ("Was there a typo in the url or port?") while curl in the same
    # session and omp started directly both could — macOS Local Network
    # privacy judges the tmux server as the responsible process. Both v1
    # pairs run non-interactively (-p), so tmux adds no takeover; the head's
    # output is in head.log either way.
    if os.environ.get("MC_HEAD_TMUX") == "1" and os.environ.get("MC_HEAD_NO_TMUX") != "1" \
            and shutil.which("tmux", path=BASE_PATH):
        tmux = shutil.which("tmux", path=BASE_PATH)
        env_args = []
        for key in ("MC_HOME", "MC_HEAD_CLONES", "MC_HEAD_TMUX", "MC_HEAD_VAULT_JOBS", "MC_HEAD_SANDBOX",
                    "MC_HEAD_SANDBOX_EXEC", "MC_HEAD_GH", "MC_HEAD_PATH", "MC_HEAD_HEARTBEAT_S", "MC_HEAD_KILL_GRACE_S",
                    "MC_HEAD_BIN_OMP", "MC_HEAD_BIN_CLAUDE", "MC_HEAD_MAX_TIME_S"):
            if key in os.environ:
                env_args += ["-e", f"{key}={os.environ[key]}"]
        res = subprocess.run(
            [tmux, "new-session", "-d", "-s", session, *env_args, shlex.join(me)],
            capture_output=True, text=True, timeout=30,
        )
        if res.returncode != 0:
            exit_status(run_id, "prepare_failed", detail=f"tmux: {res.stderr.strip()[-300:]}")
            return 4
        write_status(run_id, tmux=session)
        print(f"started in tmux session {session}")
        return 0
    log_path = run_dir(run_id) / ".wrapper" / "supervisor.log"
    with open(log_path, "ab") as fh:
        subprocess.Popen(me, stdout=fh, stderr=fh, stdin=subprocess.DEVNULL, start_new_session=True)
    print("started")
    return 0


# ── supervisor (runs inside tmux) ────────────────────────────────────────


def open_head_log(run: Path):
    """head.log lives in the run folder, where the head can create files: a
    symlink planted there must never make the (unsandboxed) wrapper append
    to a file elsewhere. Opened once, before the harness starts."""
    fd = os.open(str(run / "head.log"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    return os.fdopen(fd, "ab")


def read_head_file(path: Path) -> tuple:
    """(text, mtime) of a head-written file, never through a symlink."""
    fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as fh:
        info = os.fstat(fh.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise OSError("not a regular file")
        return fh.read().decode("utf-8", errors="replace"), info.st_mtime


def _tee(stream, fh) -> None:
    with fh:
        for chunk in iter(lambda: stream.read1(4096) if hasattr(stream, "read1") else stream.read(4096), b""):
            fh.write(chunk)
            fh.flush()
            try:
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
            except (OSError, ValueError):
                pass


def newest_worktree_mtime(root: Path, now: float) -> float | None:
    """Newest mtime of anything in the worktree — a sign the head works even
    when it prints nothing (``omp -p`` writes its output only at the end).

    Never follows a symlink (the wrapper runs unsandboxed; a head must not
    keep itself alive through a file elsewhere). Timestamps in the future
    (unpacked archives, clock skew) are ignored, or one such file would
    count as progress forever."""
    newest = None
    seen = 0
    stack = [str(root)]
    while stack:
        try:
            it = os.scandir(stack.pop())
        except OSError:
            continue
        with it:
            for entry in it:
                seen += 1
                if seen > PROGRESS_SCAN_MAX:
                    return newest
                try:
                    info = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                if info.st_mtime <= now + 60 and (newest is None or info.st_mtime > newest):
                    newest = info.st_mtime
                if stat.S_ISDIR(info.st_mode) and entry.name not in PROGRESS_SKIP_DIRS:
                    stack.append(entry.path)
    return newest


def _utc(ts: float) -> str:
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_supervise(run_id: str) -> int:
    check_run_id(run_id)
    spec = load_spec(run_id)
    run = run_dir(run_id)
    wdir = wrapper_dir(run_id)
    held: list = []
    child = None
    state = {"reason": None}

    def on_signal(signum, _frame):
        state["reason"] = state["reason"] or "stopped"
        if child is not None:
            kill_group(child.pid, KILL_GRACE_S, child)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    try:
        # A stop that arrived before this supervisor wrote its pid was
        # answered with "stopped" by cmd_stop — never start the harness then.
        if (wdir / "stop-requested").exists():
            exit_status(run_id, "stopped")
            return 0
        write_status(run_id, supervisor_pid=os.getpid())
        ok, held, busy = acquire_locks(run_id, spec["box_keys"])
        if not ok:
            exit_status(run_id, "box_busy", detail=busy)
            return 5
        home = run / "home"
        env = harness_env(spec, run, home)
        argv = sandbox_prefix(spec, run) + harness_argv(spec, run, home, env)
        if (wdir / "stop-requested").exists():
            exit_status(run_id, "stopped")
            return 0
        shown = [a if a != (run / "job.md").read_text() else "<job.md>" for a in argv]
        (wdir / "argv.json").write_text(json.dumps(shown))
        stdin = harness_stdin(spec, run)
        log_fh = open_head_log(run)
        started = time.time()
        child = subprocess.Popen(
            argv,
            cwd=str(run / "wt"),
            env=env,
            stdin=stdin,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,  # own process group → stop kills everything
        )
        write_status(run_id, phase="running", pid=child.pid, pgid=child.pid, started_at=now_iso())
        tee = threading.Thread(target=_tee, args=(child.stdout, log_fh), daemon=True)
        tee.start()
        hard_limit = min(spec["time_limit_s"], MAX_TIME_S)
        quiet_limit = min(spec["no_progress_s"], MAX_NO_PROGRESS_S)
        # The start itself is the first sign of progress: a head is never
        # stopped before it had quiet_limit seconds to show something.
        last_progress = started
        last_beat = 0.0
        beat_every = min(HEARTBEAT_S, max(1.0, quiet_limit / 4))
        while child.poll() is None:
            now = time.time()
            if now - last_beat >= beat_every:
                (wdir / "heartbeat").touch()
                # Sign of output: head.log, step.txt OR work.log — `omp -p`
                # prints only at the very end, the step file moves between
                # steps, work.log gets the tee'd output of long commands.
                mtimes = []
                for name in ("head.log", "step.txt", "work.log"):
                    try:
                        info = os.lstat(run / name)
                    except OSError:
                        continue
                    if stat.S_ISREG(info.st_mode) and info.st_mtime <= now + 60:
                        mtimes.append(info.st_mtime)
                fields = {}
                if mtimes:
                    fields["last_output_at"] = _utc(max(mtimes))
                # Sign of progress: output OR any file in the worktree.
                wt_mtime = newest_worktree_mtime(run / "wt", now)
                last_progress = max([last_progress, *mtimes] + ([wt_mtime] if wt_mtime else []))
                fields["last_progress_at"] = _utc(last_progress)
                write_status(run_id, **fields)
                last_beat = now
                if now - last_progress > quiet_limit and state["reason"] is None:
                    state["reason"] = "no_progress"
                    kill_group(child.pid, KILL_GRACE_S, child)
            if (wdir / "stop-requested").exists() and state["reason"] is None:
                state["reason"] = "stopped"
                kill_group(child.pid, KILL_GRACE_S, child)
            elif now - started > hard_limit and state["reason"] is None:
                state["reason"] = "hard_limit"
                kill_group(child.pid, KILL_GRACE_S, child)
            time.sleep(0.2)
        tee.join(timeout=5)
        code = child.returncode
        result = detect_result(spec, started)
        blocked = local_network_blocked(spec) if code else None
        reason = state["reason"] or ("local_network_blocked" if blocked else None) \
            or ("hook_bypassed" if result["hook_bypassed"] else None) or (f"exit_{code}" if code else None)
        if blocked:
            result["detail"] = blocked
        write_status(
            run_id,
            phase="exited",
            exited_at=now_iso(),
            exit_code=code,
            reason=reason,
            **result,
        )
        return 0
    except SpecInvalid as exc:
        exit_status(run_id, "spec_invalid", detail=str(exc))
        return 2
    except Exception as exc:  # noqa: BLE001 — never leave a run "running"
        if child is not None and child.poll() is None:
            kill_group(child.pid, KILL_GRACE_S, child)
        exit_status(run_id, "wrapper_error", detail=f"{exc.__class__.__name__}: {exc}"[-500:])
        return 6
    finally:
        release_locks(run_id, held)


# ── result detection (§6.5) ──────────────────────────────────────────────

_FRONTMATTER_RE = re.compile(r"\A---\n(.*?)\n---\n", re.S)


def _frontmatter_value(text: str, key: str) -> str | None:
    m = _FRONTMATTER_RE.match(text)
    if not m:
        return None
    for line in m.group(1).splitlines():
        if line.startswith(f"{key}:"):
            return line.split(":", 1)[1].strip().strip("'\"")
    return None


def find_run_record(run_id: str, started: float, ended: float) -> Path | None:
    root = vault_jobs()
    if not root.is_dir():
        return None
    for candidate in sorted(root.glob("*/run-record.md")):
        try:
            text = candidate.read_text()
            mtime = candidate.stat().st_mtime
        except OSError:
            continue
        if _frontmatter_value(text, "head_run") != run_id:
            continue
        # vault jobs/ is writable by other containers: only a file written
        # inside this run's window counts.
        if started - 5 <= mtime <= ended + 60:
            return candidate
    return None


def find_pr(spec: dict) -> str | None:
    token = gh_token()
    if not token:
        return None
    try:
        res = subprocess.run(
            [gh_bin(), "pr", "list", "--repo", spec["repo_full_name"], "--head", spec["branch"],
             "--state", "all", "--json", "url", "--limit", "1"],
            env={**os.environ, "GH_TOKEN": token, "GIT_CONFIG_GLOBAL": "/dev/null"},
            capture_output=True, text=True, timeout=60,
        )
        items = json.loads(res.stdout or "[]") if res.returncode == 0 else []
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if items and isinstance(items[0], dict) and isinstance(items[0].get("url"), str):
        url = items[0]["url"]
        if re.match(r"^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/\d+$", url):
            return url
    return None


def file_run_record(spec: dict, started: float, ended: float) -> Path | None:
    """The head writes ``<run>/run-record.md``; the wrapper (trusted) files a
    copy into ``vault/jobs/<job_folder>/run-record.md`` — only when the
    frontmatter names this run and the file was written inside the run window."""
    run_id = spec["run_id"]
    src = run_dir(run_id) / "run-record.md"
    try:
        text, mtime = read_head_file(src)
    except OSError:
        return None
    if _frontmatter_value(text, "head_run") != run_id or not (started - 5 <= mtime <= ended + 60):
        return None
    dest_dir = vault_jobs() / spec["job_folder"]
    dest_dir.mkdir(parents=True, exist_ok=True)
    tmp = dest_dir / ".run-record.md.tmp"
    tmp.write_text(text)
    os.replace(tmp, dest_dir / "run-record.md")
    return dest_dir / "run-record.md"


# What a harness prints when macOS Local Network privacy blocks it: a program
# started by launchd gets no prompt, its connects to LAN addresses just fail
# (live: omp 2026-09-24, claude 2026-10-01). Apple binaries are exempt.
LOCAL_NET_SIGNS = ("EHOSTUNREACH", "Was there a typo in the url or port?")


def local_network_blocked(spec: dict) -> str | None:
    """A clear operator step instead of a bare exit code, when the engine is
    on a LAN address and head.log shows the blocked connect."""
    try:
        host = urlsplit(spec.get("base_url") or "").hostname or ""
        addr = ipaddress.ip_address(host)
    except ValueError:
        return None
    if not addr.is_private or addr.is_loopback:
        return None
    try:
        text = read_head_file(run_dir(spec["run_id"]) / "head.log")[0][-65536:]
    except OSError:
        return None
    if not any(sign in text for sign in LOCAL_NET_SIGNS):
        return None
    return (f"local network blocked for {spec['harness']} — grant it in System Settings → "
            "Privacy & Security → Local Network (launchd starts get no prompt)")


def detect_result(spec: dict, started: float) -> dict:
    run_id = spec["run_id"]
    ended = time.time()
    record = file_run_record(spec, started, ended) or find_run_record(run_id, started, ended)
    origin = scratch_origin(spec)
    return {
        # A local origin never has a GitHub PR: there the pushed branch is
        # the result (the backend still needs a passed run record).
        "pr_url": None if origin else find_pr(spec),
        "scratch_branch_pushed": bool(origin) and scratch_branch_pushed(spec),
        "run_record_path": str(record) if record else None,
        "question": (run_dir(run_id) / "question.md").exists(),
        "hook_bypassed": hook_bypassed(spec, read_status(run_id).get("branch_tip_at_start")),
    }


# ── stop / restart ───────────────────────────────────────────────────────


def wait_exited(run_id: str, timeout: float) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        st = read_status(run_id)
        if st.get("phase") == "exited" and not locks_held_by(run_id):
            return True
        time.sleep(0.2)
    return False


def cmd_stop(run_id: str, wait: bool = True) -> int:
    check_run_id(run_id)
    if not run_dir(run_id).is_dir():
        print("unknown run")
        return 2
    st = read_status(run_id)
    if st.get("phase") == "exited":
        # A finished run keeps its result: no stop marker, or a passed run
        # would turn into "stopped".
        print("already exited")
        return 0
    wdir = wrapper_dir(run_id)
    wdir.mkdir(parents=True, exist_ok=True)
    (wdir / "stop-requested").write_text(now_iso())
    sup = st.get("supervisor_pid")
    if st.get("phase") == "starting" and not pid_alive(sup):
        exit_status(run_id, "stopped")
        print("stopped before start")
        return 0
    if not pid_alive(sup):
        # Supervisor gone: kill the harness group ourselves.
        kill_group(st.get("pgid"), KILL_GRACE_S)
        release_locks(run_id, locks_held_by(run_id))
        exit_status(run_id, "stopped")
        print("stopped (no supervisor)")
        return 0
    if not wait:
        print("stop requested")
        return 0
    if wait_exited(run_id, KILL_GRACE_S + 20):
        print("stopped")
        return 0
    print("stop requested, still exiting")
    return 1


def cmd_restart(old_id: str, new_id: str) -> int:
    check_run_id(old_id)
    check_run_id(new_id)
    if read_status(old_id).get("phase") != "exited":
        cmd_stop(old_id, wait=False)
    # Never two harness processes in the same worktree, never a false
    # box_busy against our own predecessor.
    if not wait_exited(old_id, KILL_GRACE_S + 60):
        exit_status(new_id, "previous_run_still_active")
        print("previous_run_still_active")
        return 7
    return cmd_start(new_id)


# ── gc (ADR-085 Nachtrag 2026-10-04): retention, dry run by default ─────
#
# Lives on the host, not in the backend: mc-head already owns the clones,
# worktrees, locks and git identity this needs (module docstring: "The MC
# backend never gets a shell on the host"). The backend only ever SHOWS the
# report this writes (``GET /heads/cleanup``), never triggers or computes it.
#
# Kept forever, never touched here: spec.json, job.md, procedure.md,
# run-record.md, step.txt, question.md, head.log, work.log,
# hook-passed.txt, head-settings.json, head.env, .wrapper/, .backend/,
# claude-config/**, omp-sessions/**, home/.omp/**, anything under the vault.
# Only two kinds of path are ever candidates: the literal cache allowlist
# below, and a run's own ``wt/`` worktree.


def _parse_iso(value) -> float | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None


def _dir_bytes(path: Path) -> int:
    """Sum of regular-file sizes under ``path`` — never follows a symlinked
    directory (``os.walk`` default), so a symlink planted inside cannot make
    this walk (or a later removal built on the same walk) leave the run."""
    total = 0
    if not path.exists() or path.is_symlink():
        return 0
    for root, _dirs, files in os.walk(path, onerror=lambda *_exc: None):
        for name in files:
            try:
                st = Path(root, name).lstat()
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                total += st.st_size
    return total


def _remove_tree(path: Path) -> None:
    if path.is_symlink():
        try:
            path.unlink()
        except OSError:
            pass
        return
    shutil.rmtree(path, ignore_errors=True)


def _cache_blocked_by_symlink(folder: Path, rel: str) -> bool:
    """``True`` when ANY path component between ``folder`` and
    ``folder / rel`` is a symlink, or the fully resolved target does not lie
    inside the resolved ``folder`` — review finding on PR #751: the old
    check (``p.is_symlink()``) only looked at the FINAL component
    (``home/.cache``), so a head replacing an INTERMEDIATE one
    (``home/Library -> <outside>``, or ``home -> <outside>`` itself) was
    never caught — proven end to end: ``--apply`` then deleted a sentinel
    file outside the run folder entirely. Called twice: once to decide, and
    again right before the actual ``rmtree`` (a head's sandbox can replant
    the symlink in between — ``CLONE_GIT``/``WT`` are writable throughout
    the run, and gc can run while a head is still finishing up)."""
    cur = folder
    for part in Path(rel).parts:
        cur = cur / part
        try:
            info = cur.lstat()
        except OSError:
            return False  # does not exist (yet) at this component — not a symlink issue
        if stat.S_ISLNK(info.st_mode):
            return True
    try:
        folder_r = folder.resolve()
        cur_r = cur.resolve()
    except OSError:
        return True
    return not (folder_r == cur_r or folder_r in cur_r.parents)


def _gc_candidate_run_ids() -> list:
    root = heads_root()
    if not root.is_dir():
        return []
    out = []
    try:
        entries = sorted(root.iterdir())
    except OSError:
        return []
    for entry in entries:
        if entry.name in GC_RESERVED_DIR_NAMES or not UUID_RE.match(entry.name):
            continue
        if not entry.is_dir() or entry.is_symlink():
            continue
        if (entry / "spec.json").exists():
            out.append(entry.name)
    return out


def _gc_load(run_id: str):
    """``(spec, status)`` for a run gc may consider, or ``None`` — the same
    validation gate every other entry point uses (``load_spec``): a run
    whose spec.json does not pass is left alone, never guessed at."""
    try:
        spec = load_spec(run_id)
    except SpecInvalid:
        return None
    return spec, read_status(run_id)


def _gc_skip_reason(run_id: str, spec: dict, status: dict, now: float, by_task: dict, by_restarted_from: dict) -> str | None:
    """``None`` means "consider this run for cleanup". Anything else is a
    run gc must not even look at yet (still running, just finished, or a
    predecessor/sibling still is)."""
    if status.get("phase") != "exited":
        return "not_exited"
    exited_at = _parse_iso(status.get("exited_at"))
    if exited_at is None or now - exited_at < GC_SKIP_MIN_ENDED_S:
        return "too_recent"
    if pid_alive(status.get("supervisor_pid")):
        return "supervisor_alive"
    task_id = spec.get("task_id")
    if task_id:
        for other_id in by_task.get(task_id, ()):
            if other_id != run_id and read_status(other_id).get("phase") != "exited":
                return "task_active"
    for successor_id in by_restarted_from.get(run_id, ()):
        if read_status(successor_id).get("phase") != "exited":
            return "has_active_continuation"
    return None


def _wt_safe_gitdir(spec: dict, wt: Path) -> Path | None:
    """The worktree's real git-dir INSIDE the clone, iff ``wt/.git`` is
    exactly the plain-text worktree link git itself writes — never a detour
    a head's sandbox could plant (review finding on PR #751: the sandbox's
    ``CLONE_GIT`` grant and ``wt/.git`` being head-writable together let a
    head point it at an entirely different, head-crafted bare repo carrying
    its own ``filter.x.clean`` command; every git call this module used to
    make with ``-C wt`` would then run that command the moment ``git
    status``/``symbolic-ref`` needed to compare file content).

    Returns ``None`` (the caller's ``kept`` reason: ``foreign_gitdir``) for
    ANYTHING that is not exactly: ``wt/.git`` a regular, non-symlink file
    containing ``gitdir: <path>`` whose target is a real, non-symlink
    directory directly under ``<clone>/.git/worktrees/``, whose own
    ``commondir`` resolves back to this exact clone's ``.git``. A head can
    rewrite ``wt/.git`` itself, or any of ``commondir``, at any time; this
    is called again right before every git call below, never cached.
    """
    dotgit = wt / ".git"
    try:
        info = dotgit.lstat()
    except OSError:
        return None
    if not stat.S_ISREG(info.st_mode):
        return None  # symlink, directory, or missing — never trusted
    try:
        text = dotgit.read_text(errors="replace")
    except OSError:
        return None
    m = re.match(r"^gitdir:\s*(.+?)\s*$", text, re.S)
    if not m:
        return None
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    try:
        worktrees_root = (clone / ".git" / "worktrees").resolve()
    except OSError:
        return None
    raw_gitdir = Path(m.group(1))
    gitdir = raw_gitdir if raw_gitdir.is_absolute() else (wt / raw_gitdir)
    try:
        if gitdir.is_symlink() or not gitdir.is_dir():
            return None
        gitdir_r = gitdir.resolve()
    except OSError:
        return None
    if gitdir_r.parent != worktrees_root:
        return None
    try:
        commondir_raw = (gitdir / "commondir").read_text(errors="replace").strip()
        commondir = (gitdir / commondir_raw).resolve()
    except OSError:
        return None
    try:
        clone_git = (clone / ".git").resolve()
    except OSError:
        return None
    if commondir != clone_git:
        return None
    return gitdir_r


def _wt_git(spec: dict, wt: Path, args: list) -> subprocess.CompletedProcess:
    """Run git against this worktree ONLY through an explicit
    ``--git-dir``/``--work-tree`` pointing at the gitdir ``_wt_safe_gitdir``
    just re-validated — never ``-C wt`` (which trusts ``wt/.git`` blindly,
    exactly the trap this function exists to close). The caller must have
    called ``sanitize_clone()`` on this clone first in the same decision —
    this function does not repeat it on every call, so the clone's config
    (where a filter driver's COMMAND actually lives; ``commondir`` is
    shared, so even a validated gitdir reads it from there) is only ever as
    fresh as the caller made it."""
    gitdir = _wt_safe_gitdir(spec, wt)
    if gitdir is None:
        return subprocess.CompletedProcess(args, 1, "", "foreign or missing .git")
    return _git(
        ["--git-dir", str(gitdir), "--work-tree", str(wt), *args],
        env={"GIT_OPTIONAL_LOCKS": "0"},
        check=False,
    )


def _wt_head_sha(spec: dict, wt: Path) -> str | None:
    res = _wt_git(spec, wt, ["rev-parse", "HEAD"])
    out = res.stdout.strip() if res.returncode == 0 else ""
    return out or None


def _wt_is_clean(spec: dict, wt: Path) -> bool:
    res = _wt_git(spec, wt, ["status", "--porcelain", "--untracked-files=all"])
    return res.returncode == 0 and not res.stdout.strip()


def _wt_ignored_path_is_regenerable(rel_path: str) -> bool:
    """``rel_path`` is exactly one line's path as ``git status
    --ignored=matching`` prints it after the ``"!! "`` marker: forward-slash
    separated, relative to the worktree root, optionally wrapped in double
    quotes (git quotes a path containing unusual characters). True when
    EVERY bit that makes this path worth keeping around is just a
    build/test cache: a path component matches
    ``GC_REGENERABLE_IGNORED_DIR_NAMES``, or the file itself is a bare
    ``*.pyc`` (Python can leave one next to its source outside a
    ``__pycache__`` directory too, pre-3.2 layout). Anything else — a
    head's own ``notes.md`` under ``info/exclude``, say — is not."""
    if len(rel_path) >= 2 and rel_path[0] == '"' and rel_path[-1] == '"':
        rel_path = rel_path[1:-1]
    parts = rel_path.split("/")
    if parts and parts[-1].endswith(".pyc"):
        return True
    return any(part in GC_REGENERABLE_IGNORED_DIR_NAMES for part in parts)


def _wt_has_ignored_files(spec: dict, wt: Path) -> list | None:
    """The git-ignored paths in this worktree that are NOT a known
    regenerable build/test cache (``_wt_ignored_path_is_regenerable``) —
    e.g. an ``info/exclude``-ignored notes file a head left behind on
    purpose. These are what actually BLOCK removal; a ``__pycache__`` or
    ``node_modules`` a test run left behind does not (round 3 review
    finding — see ``GC_REGENERABLE_IGNORED_DIR_NAMES``'s comment).

    Review finding on PR #751 (round 1): ``_wt_is_clean``'s own ``status``
    call never asked about ignored paths, and ``git worktree remove``
    WITHOUT ``--force`` deletes them anyway (verified directly: a clean,
    pushed scratch worktree carrying one such file lost it after
    ``--apply``). ``--ignored=matching`` lists every ignored FILE
    individually rather than collapsing a whole ignored directory into one
    entry, so a mix of regenerable and non-regenerable paths under the same
    worktree is still caught correctly, one file at a time.

    Returns the list of blocking paths (empty = nothing blocks), or
    ``None`` on a git error — the caller must treat ``None`` as "blocks",
    not as "nothing blocks": ``bool(None)`` is falsy just like
    ``bool([])``, so this is checked explicitly, never just truthiness.
    "Can't tell" must never read as "safe to delete"."""
    res = _wt_git(spec, wt, ["status", "--porcelain", "--ignored=matching"])
    if res.returncode != 0:
        return None
    blocking = []
    for line in res.stdout.splitlines():
        if not line.startswith("!! "):
            continue
        rel = line[len("!! "):]
        if not _wt_ignored_path_is_regenerable(rel):
            blocking.append(rel)
    return blocking


def _wt_is_detached(spec: dict, wt: Path) -> bool:
    res = _wt_git(spec, wt, ["symbolic-ref", "-q", "HEAD"])
    return res.returncode != 0


def _wt_head_in_scratch_origin(spec: dict, wt: Path) -> bool:
    """The clone's current HEAD is already an ancestor of the branch ref as
    it sits on the LOCAL bare origin — i.e. this exact commit was pushed.

    Never runs git directly against the bare origin (same safety as
    ``scratch_branch_pushed``/``pushed_branch_tip``, review finding on PR
    #751 — this function used to be the one exception, calling
    ``--git-dir <origin>`` straight at the untrusted bare repo): fetches the
    branch ref into the sanitized CLONE first and checks ancestry there. A
    real GitHub repo's origin is never reached this way either —
    ``scratch_origin`` already filters on that."""
    origin = scratch_origin(spec)
    if origin is None:
        return False
    sha = _wt_head_sha(spec, wt)
    if not sha:
        return False
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    ref = CHECK_REFS[1]
    try:
        sanitize_clone(spec["repo_full_name"], clone)
        fetched = _git(
            ["-C", str(clone), "fetch", "-q", "--no-tags", "--no-write-fetch-head", "origin",
             f"+refs/heads/{spec['branch']}:{ref}"],
            check=False,
        )
        if fetched.returncode != 0:
            return False
        res = _git(["-C", str(clone), "merge-base", "--is-ancestor", sha, ref], check=False)
        return res.returncode == 0
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return False
    finally:
        _git(["-C", str(clone), "update-ref", "-d", ref], check=False)


def _wt_decision(spec: dict, active_clones: frozenset) -> tuple:
    """``("removable", None, None)`` or ``("kept", reason, detail)`` for
    this run's worktree — never for a real (non-scratch) repo, v1's one
    hard line (bauplan §2.3): "Echte GitHub-Repos: v1 entfernt KEINE
    Arbeitskopie". ``detail`` is the list of blocking ignored paths when
    ``reason == "ignored_files"`` (round 3 review finding: the operator
    needs to see WHICH paths kept the worktree, now that a mix of
    regenerable and blocking ignored paths in the same worktree is
    possible), ``None`` for every other reason.

    Every git call below goes through ``_wt_git``, which revalidates
    ``wt/.git`` itself on every call (``_wt_safe_gitdir``); ``sanitize_clone``
    runs here, once, before any of them — rebuilding the clone's config from
    a fixed key list wipes any ``filter.*``/``credential.helper``/``include``
    entry a head wrote into it (review finding on PR #751). Skipped
    entirely (``clone_active``) while ANOTHER run shares this same clone and
    is still active: that run's head can re-plant the clone's config at any
    moment, and gc inspecting it mid-write is the same trust gap under a
    different name.
    """
    wt = run_dir(spec["run_id"]) / "wt"
    if spec.get("repo_full_name") not in scratch_repos():
        return "kept", "real_repo_v1", None
    if spec.get("repo_full_name") in active_clones:
        return "kept", "clone_active", None
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    try:
        sanitize_clone(spec["repo_full_name"], clone)
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return "kept", "clone_unsafe", None
    if _wt_safe_gitdir(spec, wt) is None:
        return "kept", "foreign_gitdir", None
    if not _wt_is_clean(spec, wt):
        return "kept", "dirty", None
    blocking_ignored = _wt_has_ignored_files(spec, wt)
    # Explicit ``is None`` check (not truthiness): a git ERROR must fail
    # CLOSED exactly like a real blocking path, never like "nothing
    # blocks" — ``bool(None)`` and ``bool([])`` are both falsy, so this has
    # to be spelled out rather than written as a plain ``if``.
    if blocking_ignored is None:
        return "kept", "ignored_files", None
    if blocking_ignored:
        return "kept", "ignored_files", blocking_ignored
    if _wt_is_detached(spec, wt):
        return "kept", "detached", None
    if not _wt_head_in_scratch_origin(spec, wt):
        return "kept", "not_pushed", None
    return "removable", None, None


def _remove_worktree(spec: dict, wt: Path) -> bool:
    """``git worktree remove`` WITHOUT ``--force`` — it refuses on its own
    if anything changed since the last status check (race with a
    just-started "continue"); the caller leaves the path alone on refusal.
    The local branch in the clone is untouched either way: "Weitermachen"
    re-checks it out (``prepare_worktree``)."""
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    res = _git(["-C", str(clone), "worktree", "remove", str(wt)], check=False)
    if res.returncode != 0:
        return False
    _git(["-C", str(clone), "worktree", "prune"], check=False)
    return True


def _run_gc(apply: bool) -> dict:
    now = time.time()
    loaded = {}
    by_task: dict = {}
    by_restarted_from: dict = {}
    for run_id in _gc_candidate_run_ids():
        pair = _gc_load(run_id)
        if pair is None:
            continue
        spec, status = pair
        loaded[run_id] = (spec, status)
        task_id = spec.get("task_id")
        if task_id:
            by_task.setdefault(task_id, []).append(run_id)
        restarted_from = spec.get("restarted_from")
        if restarted_from:
            by_restarted_from.setdefault(restarted_from, []).append(run_id)

    # Repos with at least one NOT-exited run right now: that run's head can
    # re-plant its shared clone's config at any moment, so every OTHER run
    # on the same clone has its worktree inspection skipped outright below
    # (``_wt_decision``'s own ``clone_active`` reason) — this is a decision
    # input, computed once against the same snapshot as everything else.
    active_clones = frozenset(
        spec.get("repo_full_name") for spec, status in loaded.values() if status.get("phase") != "exited"
    )

    # Phase 1 — DECIDE, against the UNTOUCHED disk (nothing removed yet:
    # the budget math below needs the real pre-removal size, and deciding
    # while deleting would make "how much is left" a moving target mid-walk).
    heads_bytes_before = _dir_bytes(heads_root())
    reports: dict = {}
    skipped: list = []  # [{"run_id", "reason"}] — runs gc did not even consider
    pending_removals: list = []  # (kind, ctx, path) — ctx is (folder, rel) for cache, spec for worktree
    budget_wait: list = []  # (run_id, wt, bytes, exited_at, spec)

    for run_id, (spec, status) in loaded.items():
        skip_reason = _gc_skip_reason(run_id, spec, status, now, by_task, by_restarted_from)
        if skip_reason is not None:
            skipped.append({"run_id": run_id, "reason": skip_reason})
            continue
        folder = run_dir(run_id)
        actions: list = []
        kept: list = []

        for rel in GC_CACHE_RELATIVE_PATHS:
            p = folder / rel
            if _cache_blocked_by_symlink(folder, rel):
                kept.append({"path": str(p), "reason": "symlink"})
                continue
            if not p.exists():
                continue
            actions.append({"path": str(p), "kind": "cache", "bytes": _dir_bytes(p), "would_remove": True})
            pending_removals.append(("cache", (folder, rel), p))

        wt = folder / "wt"
        if wt.is_dir() and not wt.is_symlink():
            decision, reason, detail = _wt_decision(spec, active_clones)
            wt_bytes = _dir_bytes(wt)
            if decision == "kept":
                entry = {"path": str(wt), "reason": reason}
                if detail:
                    entry["ignored"] = detail
                kept.append(entry)
            else:
                exited_at = _parse_iso(status.get("exited_at")) or now
                if now - exited_at >= GC_MIN_AGE_S:
                    actions.append({"path": str(wt), "kind": "worktree", "bytes": wt_bytes, "would_remove": True})
                    pending_removals.append(("worktree", spec, wt))
                else:
                    kept.append({"path": str(wt), "reason": "age"})
                    budget_wait.append((run_id, wt, wt_bytes, exited_at, spec))

        reports[run_id] = {"run_id": run_id, "actions": actions, "kept": kept}

    projected = heads_bytes_before
    for rep in reports.values():
        for a in rep["actions"]:
            projected -= a["bytes"]

    budget_wait.sort(key=lambda row: row[3])  # oldest exited_at first
    for run_id, wt, wt_bytes, _exited_at, spec in budget_wait:
        if projected <= GC_BUDGET_BYTES:
            break
        rep = reports[run_id]
        rep["kept"] = [k for k in rep["kept"] if k["path"] != str(wt)]
        rep["actions"].append({"path": str(wt), "kind": "worktree", "bytes": wt_bytes, "would_remove": True})
        pending_removals.append(("worktree", spec, wt))
        projected -= wt_bytes

    # Phase 2 — EXECUTE, only now, only with --apply. Every decision above
    # is final before a single byte is removed, but a cache path is
    # re-checked for a symlink right here too — the window between the
    # decision above and this line is small but real (a still-running
    # sibling step, or this very run if it has not fully exited its
    # supervisor yet) and the whole point of the check is that it is not
    # decoration.
    if apply:
        for kind, ctx, path in pending_removals:
            if kind == "cache":
                folder, rel = ctx
                if _cache_blocked_by_symlink(folder, rel):
                    continue
                _remove_tree(path)
            else:
                _remove_worktree(ctx, path)

    try:
        free_bytes = shutil.disk_usage(str(heads_root())).free
    except OSError:
        free_bytes = None

    return {
        "mode": "apply" if apply else "dry_run",
        "at": now_iso(),
        "runs": list(reports.values()),
        "skipped": skipped,
        "action_bytes": sum(a["bytes"] for rep in reports.values() for a in rep["actions"]),
        "heads_bytes": _dir_bytes(heads_root()),
        "free_bytes": free_bytes,
        "warn_low_disk": bool(free_bytes is not None and free_bytes < GC_WARN_FREE_BYTES),
        "budget_bytes": GC_BUDGET_BYTES,
    }


def _write_gc_report(report: dict) -> None:
    """Write ``heads/gc-report.json`` without ever following a symlink —
    ``heads/`` is backend-read-WRITE (mc-head's own threat model), so a
    compromised backend could pre-plant ``.gc-report.json.tmp`` as a
    symlink to redirect this write anywhere the host process can write.
    Same pattern as ``write_kz_brief``: unlink any stale tmp, then open with
    ``O_EXCL | O_NOFOLLOW`` so this process only ever writes to a file it
    JUST created itself."""
    root = heads_root()
    root.mkdir(parents=True, exist_ok=True)
    tmp = root / ".gc-report.json.tmp"
    try:
        tmp.unlink()
    except OSError:
        pass
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(report, indent=1))
    os.replace(tmp, root / "gc-report.json")


def _touch_gc_attempt_stamp() -> None:
    """``locks/gc.last`` — the throttle's OWN signal, separate from
    ``heads/gc-report.json`` (review finding on PR #751). Written at the
    very start of every ``cmd_gc`` call, success, failure, or a locked-out
    skip alike, so ``_gc_due()`` throttles on an attempt having been made,
    not on a report having been successfully produced. Before this split,
    a raised exception inside ``_run_gc`` (or the lock already being held)
    meant NO report was ever written, so ``_gc_due()`` kept returning
    ``True`` and every 30s watch tick re-ran a full pass (two tree walks
    plus a git fetch per scratch worktree) instead of backing off. It also
    means an operator deleting or inspecting the report (or a compromised
    backend touching it) cannot itself change when the NEXT real attempt
    happens. ``O_NOFOLLOW`` for the same reason as every other file under
    the backend-writable ``heads/`` tree; failing to write the stamp is
    not fatal — worst case is the old behaviour (re-attempt next tick).

    Stays a 0-byte file forever, only its mtime matters (same pattern as
    ``locks/gc.lock``) — a timestamp payload would make this file part of
    ``heads_root()``'s own byte count, which ``_run_gc``'s budget math
    (``GC_BUDGET_BYTES``) measures; a throttle bookkeeping file growing on
    every tick has no business feeding that number. ``os.utime`` on the
    open FD, not the path, so bumping an EXISTING stamp's mtime cannot
    itself be raced by a symlink swap between the open and the utime."""
    locks_root().mkdir(parents=True, exist_ok=True)
    try:
        fd = os.open(str(locks_root() / "gc.last"), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError:
        return
    try:
        os.utime(fd, None)
    except OSError:
        pass
    finally:
        os.close(fd)


def cmd_gc(apply: bool) -> int:
    """``mc-head gc [--apply]`` — never deletes anything unless ``--apply``
    (or, from ``cmd_watch``, ``MC_HEAD_GC_APPLY=1`` in the process
    environment) is given. Always writes ``heads/gc-report.json``, dry run
    or not — the report IS the dry run's result, there is no separate
    "would do" output. The throttle itself is keyed on a SEPARATE stamp
    (``_touch_gc_attempt_stamp``, written first, unconditionally), not on
    this report.

    ``fcntl.flock`` (POSIX-only, matching this whole script) keeps two
    overlapping calls — a manual run while ``watch`` is also due — from
    racing each other's removals or report write. Opened with
    ``O_NOFOLLOW`` for the same reason as ``_write_gc_report`` above
    (``locks/`` is backend-writable too); a lock that turns out to be a
    symlink is treated as "cannot lock right now", the same as any other
    lock-acquire failure."""
    import fcntl

    _touch_gc_attempt_stamp()
    heads_root().mkdir(parents=True, exist_ok=True)
    locks_root().mkdir(parents=True, exist_ok=True)
    try:
        lock_fd = os.open(str(locks_root() / "gc.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError:
        print("gc: lock unavailable, skipped")
        return 0
    lock_fh = os.fdopen(lock_fd, "a+")
    try:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("gc: already running, skipped")
        lock_fh.close()
        return 0
    try:
        report = _run_gc(apply)
    finally:
        try:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lock_fh.close()
    _write_gc_report(report)
    print(json.dumps({"mode": report["mode"], "runs": len(report["runs"]), "action_bytes": report["action_bytes"]}))
    return 0


def _gc_due() -> bool:
    try:
        mtime = (locks_root() / "gc.last").stat().st_mtime
    except OSError:
        return True
    return (time.time() - mtime) >= GC_THROTTLE_S


# ── spool watcher (launchd, §5) ──────────────────────────────────────────


def cmd_watch() -> int:
    # Throttled retention pass (ADR-085 Nachtrag 2026-10-04): runs on every
    # watch tick but only ACTS when the last report is stale, and only
    # DELETES when the host's own launchd plist carries MC_HEAD_GC_APPLY=1
    # — never from anything the backend can write. Run AFTER the spool loop
    # below (review finding on PR #751: this used to run FIRST, with a
    # comment claiming that was so "a stop/start below it never gets
    # delayed by it" — exactly backwards, since a gc pass is two full walks
    # of heads root plus a git call per worktree, and running it before the
    # loop is what delays every queued start/stop, not what protects them).
    def _run_gc_if_due() -> None:
        if _gc_due():
            try:
                cmd_gc(os.environ.get(GC_APPLY_ENV) == "1")
            except Exception as exc:  # noqa: BLE001 — gc must never block start/stop
                log(f"gc failed: {exc.__class__.__name__}: {exc}")

    spool = spool_root()
    if not spool.is_dir():
        # Still runs even when the spool folder itself does not exist yet
        # (fresh install) — nothing below needs it to exist.
        _run_gc_if_due()
        return 0
    for sub in ("processing", "done", "rejected"):
        (spool / sub).mkdir(exist_ok=True)
    wlog = spool / "watch.log"

    def note(msg: str) -> None:
        with wlog.open("a") as fh:
            fh.write(f"{now_iso()} {msg}\n")

    def order(p: Path):
        # Stops first: a start or restart can block for minutes (clone,
        # waiting on the predecessor) and must not delay another run's stop.
        try:
            mtime = p.stat().st_mtime
        except OSError:
            mtime = 0.0
        return (0 if p.name.endswith(".stop.json") else 1, mtime)

    for req in sorted(spool.glob("*.json"), key=order):
        claimed = spool / "processing" / req.name
        try:
            os.replace(req, claimed)  # atomic claim — a parallel watcher skips it
        except OSError:
            continue
        try:
            data = json.loads(claimed.read_text())
            if not isinstance(data, dict):
                raise ValueError("not an object")
        except (OSError, ValueError) as exc:
            note(f"rejected {req.name}: malformed ({exc.__class__.__name__})")
            os.replace(claimed, spool / "rejected" / req.name)
            continue
        # Only action + run ids are read from the request; everything else
        # comes from the validated spec.json.
        action = data.get("action")
        run_id = data.get("run_id")
        if action not in ("start", "stop", "restart") or not _is_uuid(run_id):
            note(f"rejected {req.name}: unknown action or bad run_id")
            os.replace(claimed, spool / "rejected" / req.name)
            continue
        try:
            if action == "start":
                rc = cmd_start(run_id)
            elif action == "stop":
                rc = cmd_stop(run_id)
            else:
                from_id = data.get("from_run_id")
                if not _is_uuid(from_id):
                    note(f"rejected {req.name}: restart without from_run_id")
                    os.replace(claimed, spool / "rejected" / req.name)
                    continue
                rc = cmd_restart(from_id, run_id)
            note(f"{action} {run_id} → rc={rc}")
        except Exception as exc:  # noqa: BLE001
            note(f"{action} {run_id} failed: {exc.__class__.__name__}: {exc}")
        os.replace(claimed, spool / "done" / req.name)
    _run_gc_if_due()
    return 0


# ── main ─────────────────────────────────────────────────────────────────


def main(argv: list) -> int:
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    try:
        if cmd == "validate" and len(args) == 1:
            return cmd_validate(args[0])
        if cmd == "start" and len(args) == 1:
            return cmd_start(args[0])
        if cmd == "_supervise" and len(args) == 1:
            return cmd_supervise(args[0])
        if cmd == "stop" and len(args) == 1:
            return cmd_stop(args[0])
        if cmd == "restart" and len(args) == 2:
            return cmd_restart(args[0], args[1])
        if cmd == "status" and len(args) == 1:
            check_run_id(args[0])
            print(json.dumps(read_status(args[0]), indent=1))
            return 0
        if cmd == "watch" and not args:
            return cmd_watch()
        if cmd == "gc" and len(args) <= 1:
            if args and args[0] != "--apply":
                print(__doc__)
                return 2
            return cmd_gc(bool(args))
    except SpecInvalid as exc:
        print(f"spec_invalid {exc}")
        return 2
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
