def harness_bin(name: str) -> str:
    override = os.environ.get(f"MC_HEAD_BIN_{name.upper()}")
    if override:
        return override
    found = shutil.which(name, path=BASE_PATH + ":" + str(Path.home() / ".local" / "bin"))
    return found or name


OMP_PROFILE = "mc-head"


def render_omp_profile(home: Path, spec: dict, env: dict) -> Path:
    """Same shape as backend host_provisioning.render_omp_host_models_yml.

    Rendered into the head's OWN $HOME, never the operator's omp config.
    """
    models_dir = home / ".omp" / "profiles" / OMP_PROFILE / "agent"
    models_dir.mkdir(parents=True, exist_ok=True)
    api_key = env.get("OPENAI_API_KEY")
    auth_line = f"    apiKey: {api_key}" if api_key else "    auth: none"
    text = (
        "providers:\n"
        "  mc-openai:\n"
        "    name: MC OpenAI-compatible endpoint\n"
        f"    baseUrl: {spec['base_url']}\n"
        "    api: openai-completions\n"
        f"{auth_line}\n"
        "    models:\n"
        f"      - id: {spec['model']}\n"
        "        name: MC model\n"
        "        reasoning: true\n"
        "        contextWindow: 262144\n"
        "        maxTokens: 32768\n"
    )
    path = models_dir / "models.yml"
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    return path


def _claude_abs(path: Path) -> str:
    """Claude Code permission syntax for an absolute path: ``//abs/path``."""
    return "/" + str(path)


def render_claude_settings(run: Path) -> Path:
    """Render the head's Claude permission list.

    The template's ``~/`` rules alone are not enough: the head runs with
    HOME=<run>/home, so ``~`` points at the throw-away folder, not at the
    operator's home. Every ``~/`` deny rule is therefore repeated with the
    REAL home as an absolute rule. Edit/Write are limited to the worktree
    and the head's own status files in the run folder — never the shell
    profile or another run.
    """
    data = json.loads(CLAUDE_SETTINGS_TEMPLATE.read_text())
    perms = data["permissions"]
    real_home = Path.home()
    deny = list(perms["deny"])
    for rule in perms["deny"]:
        m = re.match(r"^(\w+)\(~/(.*)\)$", rule)
        if m:
            deny.append(f"{m.group(1)}({_claude_abs(real_home / m.group(2))})")
    for rel in (".docker/**", ".netrc", ".git-credentials", ".kube/**", ".gnupg/**", ".aws/**",
                "Library/Keychains/**", "Library/Application Support/**", "Library/Cookies/**"):
        deny.append(f"Read({_claude_abs(real_home / rel)})")
    allow = [r for r in perms["allow"] if r not in ("Edit", "Write")]
    wt = run / "wt"
    for tool in ("Edit", "Write"):
        allow.append(f"{tool}({_claude_abs(wt)}/**)")
        for name in ("step.txt", "question.md", "run-record.md"):
            allow.append(f"{tool}({_claude_abs(run / name)})")
    perms["allow"] = allow
    perms["deny"] = deny
    target = run / "head-settings.json"
    target.write_text(json.dumps(data, indent=2))
    return target


def harness_argv(spec: dict, run: Path, home: Path, env: dict) -> list:
    job = (run / "job.md").read_text()
    procedure = str(run / "procedure.md")
    if spec["harness"] == "omp":
        render_omp_profile(home, spec, env)
        return [
            harness_bin("omp"),
            "--profile", OMP_PROFILE,
            "--model", f"mc-openai/{spec['model']}",
            "-p",
            # Keep the session in the run folder (not --no-session): it is
            # the only place omp records token usage, and the backend's
            # token harvester reads <run>/omp-sessions/*.jsonl.
            "--session-dir", str(run / "omp-sessions"),
            "--no-skills",
            "--max-time", str(spec["time_limit_s"]),
            # Permission bypass: allowed only inside the sandbox (ADR-086,
            # enforced in start_gate() for every run).
            "--auto-approve",
            "--append-system-prompt", procedure,
            job,
        ]
    if spec["harness"] == "claude":
        settings = render_claude_settings(run)
        argv = [
            harness_bin("claude"),
            "-p",
            "--bare",
            "--settings", str(settings),
            "--append-system-prompt-file", procedure,
        ]
        wt = run / "wt"
        for name in ("AGENTS.md", "CLAUDE.md"):
            if (wt / name).exists():
                argv += ["--add-dir", str(wt)]
                break
        # No prompt argument: --add-dir is variadic and would swallow it
        # (live finding). The job goes in on stdin — see harness_stdin().
        return argv
    raise SpecInvalid("harness", "not in the harness table")


def harness_stdin(spec: dict, run: Path):
    """Claude Code reads the job from stdin; omp gets it as the prompt argument."""
    if spec["harness"] == "claude":
        return open(run / "job.md", "rb")
    return subprocess.DEVNULL


def harness_env(spec: dict, run: Path, home: Path) -> dict:
    """env -i: only HOME, PATH (shims first), LANG, TERM + head.env + GH_TOKEN."""
    head_env = read_head_env(spec["run_id"])
    bindir = run / "bin"
    extra_dirs = []
    for name in ("omp", "claude"):
        b = harness_bin(name)
        if os.path.isabs(b):
            extra_dirs.append(str(Path(b).parent))
    path = ":".join([str(bindir), *extra_dirs, BASE_PATH])
    env = {
        "HOME": str(home),
        "PATH": path,
        "LANG": os.environ.get("LANG", "en_US.UTF-8"),
        "TERM": os.environ.get("TERM", "xterm-256color"),
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_AUTHOR_NAME": GIT_NAME,
        "GIT_AUTHOR_EMAIL": GIT_EMAIL,
        "GIT_COMMITTER_NAME": GIT_NAME,
        "GIT_COMMITTER_EMAIL": GIT_EMAIL,
        "MC_HEAD_RUN_DIR": str(run),
        "MC_HEAD_RUN_ID": spec["run_id"],
    }
    env.update(head_env)
    token = gh_token()
    if token:
        env["GH_TOKEN"] = token
    if spec["harness"] == "claude":
        env["CLAUDE_CONFIG_DIR"] = str(run / "claude-config")
        (run / "claude-config").mkdir(exist_ok=True)
    if spec["harness"] == "omp":
        (run / "omp-sessions").mkdir(exist_ok=True)
    return env


def sandbox_prefix(spec: dict, run: Path) -> list:
    if not sandbox_enabled():
        return []
    clone = clones_root() / spec["repo_full_name"].replace("/", "--")
    params = {
        "RUN": str(run),
        "WT": str(run / "wt"),
        "CLONE_GIT": str(clone / ".git"),
        "VAULT_JOBS": str(vault_jobs()),
        "REAL_HOME": str(Path.home()),
        "MC_HOME": str(mc_home()),
        "USER_TMP": "/private/var/folders",
        # "" for every real repo: the profile grants nothing then.
        "SCRATCH_ORIGIN": str(scratch_origin(spec) or ""),
    }
    argv = [sandbox_exec(), "-f", str(SANDBOX_PROFILE)]
    for k, v in params.items():
        argv += ["-D", f"{k}={v}"]
    return argv


