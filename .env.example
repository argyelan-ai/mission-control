# ============================================================
# Mission Control — Environment Configuration
# Run ./setup.sh to generate .env with secure random secrets,
# or copy this file to .env and fill in values yourself.
# ============================================================

# ── Core (required — setup.sh generates these) ──────────────
# PostgreSQL password
DB_PASSWORD=change_me_strong_password_here

# Redis password
REDIS_PASSWORD=change_me_generate_with_openssl_rand_hex_16

# JWT secret for user login sessions (openssl rand -hex 32)
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# Legacy single-token auth fallback (empty = disabled; prefer user login)
LOCAL_AUTH_TOKEN=

# Fernet key for encrypted API keys in the DB
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Optional service groups: comma-separated compose profiles.
# voice   = LiveKit + voice worker (needs LIVEKIT_*/XAI keys)
# browser = Playwright visual-verify sidecars for agents
# Empty = lean core stack (db, redis, backend, frontend, caddy, qdrant).
COMPOSE_PROFILES=

# Set to 1 to disable automatic DB migrations on backend start
# (for deployments that manage migrations manually).
MC_SKIP_MIGRATIONS=0

# ── Host integration (required — setup.sh fills these) ──────
# Your numeric user id (`id -u`) — used for the host tmux socket path.
HOST_UID=1000
# Absolute path of this repo checkout — used for cross-image runtime switches.
MC_REPO_PATH=

# ── Identity (optional) ──────────────────────────────────────
# How your agents address you (rendered into SOUL.md/USER.md)
OPERATOR_NAME=Operator
# Brand/site name used in generated newsletter copy
NEWSLETTER_BRAND=AI Weekly
# macOS host login for host-agent lifecycle (empty = derived from home dir)
HOST_SSH_USER=

# Wordmark/brand in the UI, split main.accent at the last dot
# (default: Mission.Control). Baked at frontend BUILD time.
NEXT_PUBLIC_BRAND=

# ── Docker images (optional) ─────────────────────────────────
# Version tag for the prebuilt core images (backend/frontend) from GHCR.
# Default: latest. Pin a release, e.g. MC_IMAGE_TAG=0.2.0 — see
# docs/setup/updating.md.
# MC_IMAGE_TAG=latest
# Registry prefix + tag for the AGENT images (mc-claude-agent,
# mc-agent-base) the compose renderer writes into
# docker/docker-compose.agents.yml. Default pulls the published GHCR
# images (since v0.2.0). Set to "" for bare local names (developer mode;
# scripts/build-agent-images.sh dual-tags, so local builds shadow pulls
# either way). omp/kimi images are always local (arm64-pinned binaries).
# MC_AGENT_IMAGE_PREFIX=ghcr.io/argyelan-ai/
# MC_AGENT_IMAGE_TAG=latest

# ── URLs / network (optional) ────────────────────────────────
# Externally reachable base URL (used in notification links)
MC_BASE_URL=http://localhost
# Interface Caddy (ports 80/443) binds to. Default 127.0.0.1 = this machine
# only (secure default — nobody on your LAN can reach MC or claim the first
# admin account). Set to 0.0.0.0 to reach MC from other devices, e.g. your
# phone via Tailscale — see README "Access from your phone".
MC_BIND_ADDRESS=127.0.0.1
# Externally reachable host (VPN/LAN IP or DNS) for CORS + phone links
PUBLIC_HOST=
# Comma-separated list of additional allowed CORS origins
EXTRA_CORS_ORIGINS=

# ── GitHub (optional — agent git workflow: repos, PRs, merges) ─
# Both values can also be set at runtime in the app (Settings → GitHub);
# values set there live in the encrypted vault and take precedence over .env.
GH_TOKEN=
# GitHub user/org under which MC creates project repos
GITHUB_OWNER=
# Repo-name prefixes the visibility monitor keeps private (comma-separated)
MC_OWNED_REPO_PREFIXES=mc-,mc-task-,t2-

# ── Discord (optional — notifications + per-agent channels) ──
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
# Webhook for ops/error notifications
DISCORD_WEBHOOK_OPS=
# Alert volume. Errors are always delivered immediately; warnings are bundled
# into one message per window, and the same topic is only sent once per TTL.
# Measured against a real 7-day history: 27.7 alerts/day unfiltered, 7.0/day
# with a 30-minute window, 5.7/day with 60 minutes.
DISCORD_DIGEST_WINDOW_SECONDS=1800
DISCORD_DEDUP_TTL_SECONDS=3600

# ── Telegram (optional — see docs/setup/telegram.md) ────────
# Prefer Settings → Telegram in the UI: tokens stored encrypted, applied
# without restart, per-function toggles. These env values are the fallback
# (and what the health watchdog reads — it must work while MC is down).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORTS_BOT_TOKEN=
TELEGRAM_REPORTS_CHAT_ID=

# ── Team chat channel selection (ADR-072) ────────────────────
# Which chat channels may run at all. Comma-separated: "telegram",
# "slack", or "telegram,slack". Empty = no explicit choice, so every
# registered channel runs if its own switch below is on.
CHAT_CHANNELS=

# ── Slack team chat (optional — see docs/setup/slack.md) ─────
# The channel's own on/off switch, and where MC writes: a channel ID
# (C0123ABCD) or #name. The two Slack TOKENS are deliberately absent —
# they live encrypted in the secrets table (ADR-033), not in .env.
SLACK_TEAM_CHAT_ENABLED=false
SLACK_DEFAULT_CHANNEL=
# Reports channel for final task reports (the OperatorReports adapter).
# Empty = reports keep going out via the Telegram reports bot only.
SLACK_REPORTS_CHANNEL=
# Size cap for files the operator sends TO MC via Slack (file ingest ->
# reference files, ADR-053). Bytes; default 25 MB.
SLACK_FILE_INGEST_MAX_BYTES=26214400
# Approvals channel (#mc-approvals). Empty = no Slack approvals; the
# Telegram approval buttons keep working independently (fan-out).
SLACK_APPROVALS_CHANNEL=

# ── Jarvis Telegram-Inbound (optional — mobile Jarvis via Telegram, ADR-061) ─
# Text + voice messages from TELEGRAM_CHAT_ID are answered by the JarvisBrain.
# Default false → behaviour unchanged (only approval URL buttons). Requires
# OPENAI_API_KEY + JARVIS_AGENT_TOKEN (both below) to actually activate.
JARVIS_TELEGRAM_ENABLED=false
# Chat model for the text brain (conservative default).
JARVIS_TEXT_MODEL=gpt-4o-mini
# Transcription model for Telegram voice notes (ogg/opus sent directly).
JARVIS_STT_MODEL=gpt-4o-mini-transcribe
# Local/self-hosted STT endpoint (OpenAI-compatible). When set, voice
# messages are transcribed THERE instead of the OpenAI cloud, and no
# OPENAI_API_KEY is needed for transcription. See scripts/stt-server/ for a
# ready-made local server (Parakeet v3 on Apple Silicon).
# STT_BASE_URL=http://host.docker.internal:8585/v1
# Model name sent to that endpoint (most local servers ignore it).
# STT_MODEL=

# ── Jarvis Intelligence (optional — ADR-062) ─────────────────────────────────
# Frontier model for ask_frontier (heavy analysis/planning) + the morning
# briefing. Empty → jarvis_core default (gpt-5.5 as of 2026-07-10). Override to
# pin a specific model (e.g. gpt-5.5-pro, gpt-4o).
JARVIS_FRONTIER_MODEL=
# ask_frontier TOOL gate — off by default: Frontier-Calls cost per request. When
# false the tool is not offered in any channel schema (voice + telegram). The
# daily briefing below has its own gate and is NOT affected by this.
JARVIS_FRONTIER_ENABLED=false
# Daily LLM-generated morning briefing written as a vault note. Default off;
# needs OPENAI_API_KEY set to activate.
JARVIS_BRIEFING_ENABLED=false
# Local time (Europe/Zurich, HH:MM) the briefing is generated at.
JARVIS_BRIEFING_HOUR=06:30

# ── Voice agent (optional — LiveKit + OpenAI/xAI realtime) ───
# LiveKit server key list, YAML mapping format WITH the space: "key: secret"
LIVEKIT_KEYS=
# Same pair split for backend token signing
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# WS URL the browser client connects to (empty = derived from request origin)
LIVEKIT_PUBLIC_URL=
# RTC candidate IP LiveKit advertises (your LAN/VPN IP; 127.0.0.1 = local only)
LIVEKIT_NODE_IP=
# EMERGENCY DEFAULT ONLY (ADR-074). Which provider Jarvis actually speaks to is
# a runtime binding on the Jarvis agent in MC — pick it in the runtime selector
# on the agent page. The worker fetches that binding at the start of every call,
# so a switch takes effect on the next call with no restart. These two values
# apply only when the backend does not answer, or nothing is bound yet.
VOICE_PROVIDER=openai
# Belongs to the arm named above — it is ignored while any other arm is active.
VOICE_MODEL=gpt-realtime-2.1
# Voice per arm — the providers' voice names are disjoint, so one shared value
# would break whichever arm does not know the name. Empty = that arm's default
# (OpenAI "marin", xAI "ara").
VOICE_OPENAI_VOICE_ID=
VOICE_XAI_VOICE_ID=
# OpenAI API key for the realtime voice model (default provider)
OPENAI_API_KEY=
# xAI API key for the realtime voice model (fallback provider)
XAI_API_KEY=
# MC agent token for the voice worker (create the agent, then paste its token)
JARVIS_AGENT_TOKEN=

# ── Remote LLM runtime host via SSH (optional) ───────────────
# If you run LM Studio / vLLM / Unsloth on a separate machine, MC connects
# via SSH for lifecycle commands (load/unload, docker start/stop). Requires
# the ~/.ssh mount from docker-compose.override.example.yml.
DGX_SSH_HOST=
DGX_SSH_USER=
DGX_SSH_KEY_PATH=/home/mcuser/.ssh/id_rsa

# ── Runtime registry ─────────────────────────────────────────
# On first start MC seeds backend/config/runtimes.json into the `runtimes`
# DB table. Edit that JSON to reflect YOUR hardware (endpoint URLs, model
# identifiers). After the first seed, manage runtimes via the UI (/runtimes).

# ── Feature flags (optional, defaults shown) ─────────────────
# Kill-switch: false = legacy single-session dispatch (rollback, ADR-002)
USE_SUBAGENT_DISPATCH=true
ENABLE_DISPATCH_GATING=false
STRUCTURED_INTAKE_ENABLED=false
ENABLE_PROMOTE_ORCHESTRATOR=false

# Eigener AI-Server (optional): OpenAI-kompatible Endpoints fuer Embedding + LLM.
# SPARK_EMBEDDING_URL leer = Embeddings nicht konfiguriert: MC macht dann
# KEINEN Netzversuch und speichert Memories ohne Vektor, bis eine URL gesetzt
# ist (hier oder unter Settings -> KI-Provider).
# SPARK_EMBEDDING_URL=http://<dein-server>:1234/v1/embeddings
# SPARK_LLM_URL=http://<gpu-host>:8000/v1

# ── MCs eigene KI-Funktionen: welcher Anbieter bedient sie ───
# Nicht zu verwechseln mit dem, womit die AGENTEN denken (das kommt aus
# ihrer Runtime). Hier geht es um MC selbst: Embeddings fuer die
# Gedaechtnis-Suche und den taeglichen Insights-Bericht.
# Bequemer ueber Settings -> Anschluesse -> KI-Provider (wirkt sofort, ohne
# Neustart) — die Seite ueberschreibt diese Werte. Anleitung:
# docs/setup/ai-providers.md
#
# Leere Override-Felder erben die Voreinstellung des gewaehlten Anbieters.
# Embeddings haben zwei Arme, jeder mit EIGENEN Feldern (Umschalten ist
# damit immer ein vollstaendiger Wechsel):
#   spark = eigener Server (LM Studio, llama.cpp, vLLM — OpenAI-kompatibel)
#   cloud = gehosteter OpenAI-kompatibler /v1/embeddings-Endpoint
#           (Together, DeepInfra, Fireworks, ...) — Schluessel in den Vault
AI_EMBEDDINGS_PROVIDER=spark          # spark | cloud
AI_EMBEDDINGS_URL=                    # leer = SPARK_EMBEDDING_URL
AI_EMBEDDINGS_MODEL=                  # leer = SPARK_EMBEDDING_MODEL
AI_EMBEDDINGS_CLOUD_URL=              # z.B. https://api.together.xyz/v1/embeddings
AI_EMBEDDINGS_CLOUD_MODEL=            # z.B. nomic-ai/nomic-embed-text-v1.5
AI_INSIGHTS_PROVIDER=spark            # spark | ollama_cloud | off
AI_INSIGHTS_MODEL=                    # leer = das Modell, das die Box gerade faehrt

# Ollama Cloud = ollama.com — NUR fuer Insights (ollama.com hostet keine
# Embedding-Modelle). Ein LOKALES Ollama ist bewusst keine Option (frisst
# auf Apple Silicon denselben Speicher wie Docker). Der Schluessel gehoert
# in den Vault (Settings), nicht hierher.
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_INSIGHTS_MODEL=qwen3-coder:480b-cloud
